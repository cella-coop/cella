{
  "permissions": {
    "deny": [
      "Edit(apps/site/src/content/**)",
      "Write(apps/site/src/content/**)",
      "NotebookEdit(apps/site/src/content/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"$CLAUDE_PROJECT_DIR/tools/site-text-guard.sh\""
          }
        ]
      }
    ]
  }
}
