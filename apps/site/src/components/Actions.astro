---
// A row of actions as a row of cells (index.md, the layout): side by side,
// their tops and feet aligned, each pair sharing a slanted edge cut by one
// gutter, the row's two ends bulging as a cluster's rim. Its cells are its
// links, the first solid in the ink and the rest a wash of it, or what its
// slot holds, any element of class `cell` whose `data-tone` is `fill` or
// `wash`, as a form's field and button. The cells are drawn once the row
// is laid out, and again when it changes size; before that, and with no
// script, each is a plain rounded fill.
import type { Link, Status } from '../schemas'
import type { Marks } from '../lib/text'

interface Props {
  links?: { link: Link; field: string }[]
  ink: Status
  seed: number
  drafted?: Marks
}

const { links = [], ink, seed, drafted = () => undefined } = Astro.props
const P = { error: 0, warning: 1, success: 2, info: 3, help: 4 }
---

<div class="actions" data-cells data-seed={seed} style={{ '--ink': `var(--p${P[ink]})` }}>
  <svg aria-hidden="true"></svg>
  {
    links.map(({ link, field }, i) => (
      <a class="cell" data-tone={i ? 'wash' : 'fill'} href={link.href} data-drafted={drafted(field)}>
        {link.label}
      </a>
    ))
  }
  <slot />
</div>

<script>
  import { roundedPath, rng, type Point } from '@cella/brand'

  const f = (v: number) => v.toFixed(1)

  // each cell's outline: flat along the row's top and foot, its shared
  // sides slanted by a seeded tilt and parted by the gutter, its outer
  // ends bulging past the label
  function outlines(widths: number[], h: number, seed: number, gutter: number): Point[][] {
    const rand = rng(seed)
    const xs = widths.reduce((acc, w) => [...acc, acc[acc.length - 1] + w], [0])
    const tilt = xs.map((_, i) => (i % 2 ? 1 : -1) * h * (0.14 + rand() * 0.12))
    const bulge = h * 0.3
    return widths.map((_, i) => {
      const [l, r] = [xs[i], xs[i + 1]]
      const left: Point[] = i === 0
        ? [[l + bulge, 0], [l, h * (0.42 + rand() * 0.16)], [l + bulge, h]]
        : [[l + tilt[i] / 2 + gutter / 2, 0], [l - tilt[i] / 2 + gutter / 2, h]]
      const right: Point[] = i === widths.length - 1
        ? [[r - bulge, h], [r, h * (0.42 + rand() * 0.16)], [r - bulge, 0]]
        : [[r - tilt[i + 1] / 2 - gutter / 2, h], [r + tilt[i + 1] / 2 - gutter / 2, 0]]
      return [...left, ...right]
    })
  }

  function draw(row: HTMLElement) {
    const svg = row.querySelector('svg')!
    const cells = [...row.querySelectorAll<HTMLElement>('.cell')]
    const box = row.getBoundingClientRect()
    const h = box.height
    const polys = outlines(cells.map((c) => c.getBoundingClientRect().width), h, Number(row.dataset.seed), 5)
    svg.setAttribute('viewBox', `0 0 ${f(box.width)} ${f(h)}`)
    svg.innerHTML = polys.map((p, i) => `<path class="${cells[i].dataset.tone ?? 'fill'}" d="${roundedPath(p, h * 0.2, f)}"/>`).join('')
    row.dataset.drawn = ''
    cells.forEach((c, i) => {
      const path = svg.children[i]
      c.addEventListener('mouseenter', () => path.classList.add('lift'))
      c.addEventListener('mouseleave', () => path.classList.remove('lift'))
      c.addEventListener('focus', () => path.classList.add('lift'))
      c.addEventListener('blur', () => path.classList.remove('lift'))
    })
  }

  const rows = [...document.querySelectorAll<HTMLElement>('[data-cells]')]
  const watch = new ResizeObserver((entries) => entries.forEach((e) => draw(e.target as HTMLElement)))
  document.fonts.ready.then(() => rows.forEach((r) => watch.observe(r)))
</script>

<style>
  .actions {
    --fill: oklch(from var(--ink) calc(0.58 - var(--theme) * 0.04) c h);
    --on-fill: oklch(0.985 0.004 250);
    --wash: oklch(from var(--ink) calc(0.62 + var(--theme) * 0.28) 0.045 h);
    --on-wash: oklch(from var(--ink) calc(0.61 - var(--theme) * 0.25) 0.1 h);
    position: relative;
    display: inline-flex;
    max-width: 100%;
    isolation: isolate;
  }

  svg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  svg :global(path) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.2s var(--ease), fill 0.2s var(--ease);
  }

  svg :global(.fill) {
    fill: var(--fill);
  }

  svg :global(.wash) {
    fill: var(--wash);
  }

  svg :global(.lift) {
    transform: scale(1.03);
  }

  .actions :global(.cell) {
    min-width: 0;
    margin: 0;
    padding: 0.95rem 1.7rem;
    border: 0;
    border-radius: 0.9rem;
    background: var(--fill);
    color: var(--on-fill);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .actions :global(.cell[data-tone='wash']) {
    background: var(--wash);
    color: var(--on-wash);
  }

  .actions :global(.cell + .cell) {
    margin-left: 0.4rem;
  }

  /* drawn, the cells are the svg's, side by side with no gap */
  [data-drawn] :global(.cell) {
    background: none;
  }

  [data-drawn] :global(.cell + .cell) {
    margin-left: 0;
  }

  .actions :global(.cell:focus-visible) {
    outline: 2px solid var(--text);
    outline-offset: -5px;
    border-radius: 0.6rem;
  }

  @media (max-width: 30rem) {
    .actions :global(.cell) {
      padding: 0.85rem 1.2rem;
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg :global(path) {
      transition: none;
    }
  }
</style>
