---
// A row of actions as a row of cells (index.md, the layout): side by side,
// their tops and feet aligned, each pair sharing a slanted edge cut by one
// gutter, the row's two ends bulging as a cluster's rim. Its cells are its
// links, the first solid in the ink and the rest a wash of it, or what its
// slot holds, any element of class `cell` whose `data-tone` is `fill`,
// `wash` or `plain`, a breath of the text's own ink, as a form's field
// and button. The cells are drawn once the row
// is laid out, and again when it changes size; before that, and with no
// script, each is a plain rounded fill. Its ink is `ink`, or else its
// section's, which it inherits; a page writes its links as `Action`s.
import type { Link, Status } from '../schemas'
import type { Marks } from '../lib/text'
import { swatch } from '../lib/place'

interface Props {
  links?: { link: Link; field: string }[]
  ink?: Status
  seed?: number
  drafted?: Marks
}

const { links = [], ink, seed = 7, drafted = () => undefined } = Astro.props
---

<div class="actions" data-cells data-seed={seed} style={ink ? { '--ink': swatch(ink) } : undefined}>
  <svg aria-hidden="true"></svg>
  {
    links.map(({ link, field }, i) => (
      <a class="cell" data-tone={i ? 'wash' : 'fill'} href={link.href} data-drafted={drafted(field)}>
        {link.label}
      </a>
    ))
  }
  <slot />
</div>

<script>
  import { actionCells, actionPath, rng } from '@cella/brand'

  const f = (v: number) => v.toFixed(1)

  // each cell's outline is the brand's (`actions.ts`): its shared sides
  // slanted by a seeded tilt and parted by the gutter, its outer ends
  // bulging past the label
  function draw(row: HTMLElement) {
    const svg = row.querySelector('svg')!
    const cells = [...row.querySelectorAll<HTMLElement>('.cell')]
    const box = row.getBoundingClientRect()
    const h = box.height
    const polys = actionCells(cells.map((c) => c.getBoundingClientRect().width), h, rng(Number(row.dataset.seed)), 6)
    svg.setAttribute('viewBox', `0 0 ${f(box.width)} ${f(h)}`)
    svg.innerHTML = polys.map((p, i) => `<path class="${cells[i].dataset.tone ?? 'fill'}" d="${actionPath(p, h, f)}"/>`).join('')
    row.dataset.drawn = ''
    cells.forEach((c, i) => {
      const path = svg.children[i]
      c.addEventListener('mouseenter', () => path.classList.add('on'))
      c.addEventListener('mouseleave', () => path.classList.remove('on'))
      // focus rings the cell's own outline, where the keyboard brought it
      // or the cell takes typing
      c.addEventListener('focus', () => {
        path.classList.add('on')
        path.classList.toggle('ring', c.matches(':focus-visible'))
      })
      c.addEventListener('blur', () => path.classList.remove('on', 'ring'))
    })
  }

  const rows = [...document.querySelectorAll<HTMLElement>('[data-cells]')]
  const watch = new ResizeObserver((entries) => entries.forEach((e) => draw(e.target as HTMLElement)))
  document.fonts.ready.then(() => rows.forEach((r) => watch.observe(r)))
</script>

<style>
  .actions {
    --fill: oklch(from var(--ink) calc(0.58 - var(--theme) * 0.04) c h);
    --fill-on: oklch(from var(--ink) calc(0.58 - var(--theme) * 0.1) c h);
    --on-fill: oklch(0.985 0.004 250);
    --wash: oklch(from var(--ink) calc(0.62 + var(--theme) * 0.28) 0.045 h);
    --wash-on: oklch(from var(--ink) calc(0.62 + var(--theme) * 0.24) 0.06 h);
    --plain: color-mix(in oklch, var(--text) 9%, var(--panel));
    --plain-on: color-mix(in oklch, var(--text) 13%, var(--panel));
    --on-plain: var(--text);
    --on-wash: oklch(from var(--ink) calc(0.61 - var(--theme) * 0.25) 0.1 h);
    position: relative;
    display: inline-flex;
    max-width: 100%;
    isolation: isolate;
  }

  svg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* a cell never moves, so the gutters hold: a hovered or focused one
     deepens its tone */
  svg :global(path) {
    transition: fill 0.2s var(--ease);
  }

  svg :global(.fill) {
    fill: var(--fill);
  }

  svg :global(.wash) {
    fill: var(--wash);
  }

  svg :global(.plain) {
    fill: var(--plain);
  }

  svg :global(.plain.on) {
    fill: var(--plain-on);
  }

  svg :global(.ring) {
    stroke: var(--text);
    stroke-width: 2;
  }

  svg :global(.fill.on) {
    fill: var(--fill-on);
  }

  svg :global(.wash.on) {
    fill: var(--wash-on);
  }

  .actions :global(.cell) {
    min-width: 0;
    margin: 0;
    padding: 0.95rem 1.7rem;
    border: 0;
    border-radius: 0.9rem;
    background: var(--fill);
    color: var(--on-fill);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .actions :global(.cell[data-tone='wash']) {
    background: var(--wash);
    color: var(--on-wash);
  }

  .actions :global(.cell[data-tone='plain']) {
    background: var(--plain);
    color: var(--on-plain);
  }

  .actions :global(.cell + .cell) {
    margin-left: 0.4rem;
  }

  /* drawn, the cells are the svg's, side by side with no gap */
  .actions[data-drawn] :global(.cell[data-tone]) {
    background: none;
  }

  .actions[data-drawn] :global(.cell + .cell) {
    margin-left: 0;
  }

  /* before the cells are drawn, focus rings the plain fill; once drawn,
     the cell's outline carries the ring */
  .actions :global(.cell:focus-visible) {
    outline: 2px solid var(--text);
    outline-offset: -5px;
    border-radius: 0.6rem;
  }

  .actions[data-drawn] :global(.cell:focus-visible) {
    outline: none;
  }

  /* narrower on a phone, but never under a finger's 44px tall */
  @media (max-width: 30rem) {
    .actions :global(.cell) {
      padding: 0.95rem 1.2rem;
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg :global(path) {
      transition: none;
    }
  }
</style>
