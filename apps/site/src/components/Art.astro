---
// A print filling its side of a band, in the band's tone, cut where it
// meets the page along an edge drawn as an edge of the mark's cells: two
// straight runs and one turn, the page's side convex as a cell (index.md,
// the cut). `side` is the print's side; on a narrow screen it stands above
// the words, cut at its foot. Its two cuts are clip paths of its own,
// seeded by `key`.
import type { Status } from '../lib/photo'
import { cut } from '../lib/cut'
import Backdrop from './Backdrop.astro'

interface Props {
  photo: string | { photo: string; ink?: Status }
  tone: Status
  side: 'start' | 'end'
  key: string
}

const { photo, tone, side, key } = Astro.props
const name = typeof photo === 'string' ? photo : photo.photo
const id = `cut-${key.replace(/[^a-z0-9-]/g, '-')}`
const wide = cut(key, side === 'end' ? 'left' : 'right', { reach: [0.12, 0.42], round: 0.05 })
const narrow = cut(`${key}-narrow`, 'below', { reach: [0.12, 0.34], round: 0.05 })
const clips = { '--cut': `url(#${id}-wide)`, '--cut-narrow': `url(#${id}-narrow)` }
---

<svg class="clips" aria-hidden="true" width="0" height="0">
  <clipPath id={`${id}-wide`} clipPathUnits="objectBoundingBox"><path d={wide} /></clipPath>
  <clipPath id={`${id}-narrow`} clipPathUnits="objectBoundingBox"><path d={narrow} /></clipPath>
</svg>
<div class="art" data-side={side} style={clips}>
  <Backdrop photo={{ photo: name, ink: tone }} size={'hero'} narrow={'large'} />
</div>

<style>
  .clips {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* The print: three fifths of the band, top to foot, cut on its near side */
  .art {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60%;
    clip-path: var(--cut);
  }

  .art[data-side='end'] {
    right: 0;
  }

  .art[data-side='start'] {
    left: 0;
  }

  .art[data-side='start'] :global(.credit) {
    right: auto;
    left: 0.75rem;
  }

  @media (max-width: 56rem) {
    .art,
    .art[data-side='end'],
    .art[data-side='start'] {
      position: relative;
      width: 100%;
      height: max(16rem, 62vw);
      clip-path: var(--cut-narrow);
    }

    .art :global(.credit),
    .art[data-side='start'] :global(.credit) {
      top: 0.5rem;
      right: 0.75rem;
      bottom: auto;
      left: auto;
    }
  }
</style>
