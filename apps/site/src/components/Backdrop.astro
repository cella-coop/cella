---
// A photo in the house's print filling the panel that holds it, as the
// brand explorer shows a print: the print's light paper and a real ink,
// the same in either theme, the paper's grain over it (index.md, prints).
// Its mask is a file printed at the panel's width, a smaller one on a
// phone, so its dots are the cell's size; the page colours it with the
// ink. It is decorative; its credit sits in its corner, as Unsplash asks.
import '@cella/brand/print.css'
import { getEntry } from 'astro:content'
import { creditParts, type Status } from '../lib/photo'
import { inkOf, inkVar, maskUrl, type Size } from '../lib/print'
import { readFileSync } from 'node:fs'
import { join } from 'node:path'

interface Props {
  photo: string | { photo: string; ink?: Status }
  size?: Size
  narrow?: Size
  // the print's plain ink, its text's, in place of a status's
  plain?: boolean
}

const { photo, size = 'large', narrow = 'small', plain = false } = Astro.props
const { photo: name, ink } = typeof photo === 'string' ? { photo, ink: undefined } : photo
const meta = JSON.parse(readFileSync(join(process.cwd(), 'src/photos', `${name}.json`), 'utf8')) as { photographer: string; photographerUrl: string; photoUrl: string }
const site = (await getEntry('site', 'site'))!.data
const { beforeName, between, afterUnsplash } = creditParts(site.photo.credit)
const referral = (url: string) => {
  const u = new URL(url)
  u.searchParams.set('utm_source', 'cella')
  u.searchParams.set('utm_medium', 'referral')
  return u.href
}
const masks = {
  '--ink': plain ? 'var(--print-text)' : inkVar(inkOf(name, ink)),
  '--mask': `url(${maskUrl(name, size)})`,
  '--mask-small': `url(${maskUrl(name, narrow)})`,
}
---

<div class="backdrop" style={masks} aria-hidden="true"><span /></div>
<p class="credit">
  {beforeName}<a href={referral(meta.photographerUrl)}>{meta.photographer}</a>{between}<a href={referral(meta.photoUrl)}>{site.photo.unsplash}</a>{afterUnsplash}
</p>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    isolation: isolate;
    background: var(--print-paper);
    pointer-events: none;
  }

  .backdrop span {
    position: absolute;
    inset: 0;
    background: var(--ink);
    mask: var(--mask) center / cover no-repeat;
    mix-blend-mode: multiply;
  }

  /* The print is on the paper: the panel's grain lies over it */
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain-panel);
    mix-blend-mode: multiply;
    opacity: 0.5;
  }

  @media (max-width: 40rem) {
    .backdrop span {
      mask-image: var(--mask-small);
    }
  }

  .credit {
    position: absolute;
    right: 0.75rem;
    bottom: 0.5rem;
    z-index: 2;
    margin: 0;
    /* in the print's own muted ink: its paper is light in either theme */
    color: var(--print-muted);
    font-size: var(--t-xs);
    opacity: 0.8;
  }

  .credit a {
    color: inherit;
  }
</style>
