---
// The layout every section of a page shares (index.md, the layout), which
// `Hero`, `Section` and `Band` hand their props and body to. Its words
// stand beside its figure, on the side `flip` gives, the figure bleeding
// off the screen's outer edge; a band is a strong ink, its edges cut as a
// cell's, holding no photo but its diagram or its icon, drawn light on its
// colour, and quoting where it says so. Its ink is set on it, so what its
// body places, actions, forms and lists, takes it; a band hands its lists
// the four other inks. Its `numeral`, where it has one, is a ghost numeral.
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import { diagrams, type DiagramName } from '@cella/diagrams'
import type { Figure, Status } from '../schemas'
import { outlinePath, outlineShape } from '../lib/edge'
import { glyphPaths } from '../lib/icon'
import { anchor, handed, swatch } from '../lib/place'
import { refuse, where } from '../lib/refuse'
import { siteData } from '../lib/text'
import Diagram from './Diagram.astro'
import Engraving from './Engraving.astro'
import Heading from './Heading.astro'
import BandGlyph from './BandGlyph.astro'

interface Props {
  kind: 'hero' | 'section' | 'band'
  id?: string
  eyebrow?: string
  heading: string
  figure?: Figure
  diagram?: string
  icon?: string
  ink: Status
  quote?: boolean
  // its body set as reading text, not as a lede
  prose?: boolean
  flip?: boolean
  numeral?: number
  seed: number
}

const { kind, id, eyebrow, heading, figure, diagram, icon, ink, quote = false, prose = false, flip = false, numeral, seed } = Astro.props
const hero = kind === 'hero'
const band = kind === 'band'
const at = where(kind, heading)

// a band holds a diagram or an icon and no photo; anything else, no plate
if (band && !diagram && !icon) {
  throw refuse.plateless(at)
}
if (band && diagram && icon) {
  throw refuse.twoPlates(at)
}
if (band && figure) {
  throw refuse.photoOnBand(at, figure.photo)
}
if (!band && (diagram || icon)) {
  throw refuse.plateOffBand(at)
}
if (diagram && !(diagram in diagrams)) {
  throw refuse.unknownDiagram(at, diagram)
}
if (figure && !existsSync(join(process.cwd(), 'src/photos', `${figure.photo}.json`))) {
  throw refuse.unknownPhoto(at, figure.photo)
}

const site = await siteData()
const credit = { template: site.photo.credit, unsplash: site.photo.unsplash }
const none = () => undefined
const body = Astro.slots.has('default')
// a quote's opening mark, Phosphor's filled quotes, a closing mark, turned
const marks = band && quote ? glyphPaths('quotes', 'fill') : ''
const box = '0 0 256 256'

// A band's outline (lib/edge.ts): a CSS shape whose edges keep their
// depth however tall the band grows, and, where a browser lacks shape(),
// the same outline as an SVG clip that stretches with the band
const anchorId = hero ? undefined : (id ?? anchor(heading))
const clip = band ? `band-${anchorId ?? seed}` : undefined
const outline = band ? outlinePath(seed) : undefined
// a band's icon stands behind its words, not beside them (BandGlyph)
const paired = Boolean(figure || diagram)
const style = { '--ink': swatch(ink), ...(band ? handed(ink) : {}), ...(clip ? { '--clip': `url(#${clip})`, '--outline': outlineShape(seed) } : {}) }
---

<section id={anchorId} class:list={['section', { hero }]} data-band={band ? ink : undefined} style={style}>
  {
    outline && (
      <svg class="edge" width="0" height="0" aria-hidden="true">
        <clipPath id={clip} clipPathUnits="objectBoundingBox"><path d={outline} /></clipPath>
      </svg>
    )
  }
  {icon && <BandGlyph name={icon} seed={seed} flip={flip} />}
  {
    band && quote ? (
      <div class:list={['wrap', paired ? 'pair' : 'single', { flip }]}>
        <blockquote>
          {body && (
            <div class="said">
              <svg class="mark" viewBox={box} aria-hidden="true" set:html={marks} />
              <slot />
            </div>
          )}
          <cite class="label">{heading}</cite>
        </blockquote>
        {diagram && <div class="plate"><Diagram name={diagram as DiagramName} band edge={flip ? 'l' : 'r'} /></div>}
      </div>
    ) : (
      <div class:list={['wrap', paired ? 'pair' : 'single', { flip, overhang: hero }]}>
        <div class="copy">
          {numeral !== undefined && <span class="num" aria-hidden="true">{String(numeral).padStart(2, '0')}</span>}
          {eyebrow && <p class="label">{eyebrow}</p>}
          <Heading text={heading} level={hero ? 1 : 2} />
          {body && <div class:list={['body', { lede: !prose }]}><slot /></div>}
        </div>
        {diagram && <div class="plate"><Diagram name={diagram as DiagramName} band edge={flip ? 'l' : 'r'} /></div>}
        {figure && <Engraving figure={figure} ink={figure.ink ?? ink} seed={seed} bleed={flip ? 'l' : 'r'} aspect={hero ? 1.3 : 1.2} credit={credit} drafted={none} />}
      </div>
    )
  }
</section>

<style>
  .section {
    position: relative;
  }

  .hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .pair.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  /* words whose cells stand side by side, or that hold a form, take half
     the width, not five twelfths, so the cells and the fields have room;
     on a wide screen alone, since this outranks the narrow screen's one
     column */
  @media (min-width: 56.01rem) {
    .pair:has(:global(:is(.list:is([data-layout='row'], [data-layout='grid'], [data-layout='steps']), form))) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .pair.flip > :global(figure),
  .pair.flip > .plate {
    order: -1;
  }

  .single {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .single .copy {
    max-width: 44rem;
  }

  /* words alone trade sides too, their column to the right, a quote's
     as a heading's, so a band's icon stands clear of them */
  .single.flip .copy,
  .single.flip blockquote {
    margin-left: auto;
  }

  /* the hero's figure overhangs the section after it */
  .overhang {
    margin-bottom: clamp(-7rem, -8vw, -3rem);
  }

  /* the words' column is a container, so what they hold, lists and
     forms, lays itself out by the column's width, not the screen's */
  .copy {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    display: grid;
    gap: 1.5rem;
    align-content: center;
  }

  /* the number: a ghost numeral, huge and faint behind the words, out
     toward the screen's edge on their outer side, the left unless the
     figure takes it, a gutter in from it and never more than 6rem past
     the column, so a wide screen keeps it by its words; whole on any
     width */
  .num {
    --out: min(calc((100vw - min(100vw, var(--wrap))) / 2), 6rem);
    position: absolute;
    top: -0.32em;
    left: calc(-1 * var(--out));
    z-index: -1;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(11rem, 24vw, 22rem);
    font-weight: 200;
    letter-spacing: -0.05em;
    line-height: 1;
    opacity: 0.07;
    pointer-events: none;
    user-select: none;
  }

  .flip .num {
    right: calc(-1 * var(--out));
    left: auto;
  }

  .body > :global(*) {
    margin-block: 0;
  }

  .body > :global(* + *) {
    margin-top: 1em;
  }

  .body > :global(.list) {
    margin-block: 2rem 2.25rem;
  }

  .body > :global(:is(.actions, form)) {
    margin-top: 1.75rem;
  }

  .body > :global(.actions) {
    width: fit-content;
  }

  .lede > :global(p) {
    max-width: 33rem;
    color: var(--text-muted);
    font-size: clamp(1.1rem, 1.45vw, 1.28rem);
  }

  /* the breaks: shaped bands of ink, their edges cut as a cell's */
  [data-band] {
    padding-block: clamp(7rem, 12vw, 10rem) clamp(5rem, 9vw, 8rem);
  }

  /* a band is a strong ink, its words and its diagram light on it: the
     sage and the coral the site set first, the other three deepened
     alike from their inks */
  [data-band='success'] {
    --band: var(--band-a);
    --band-ink: var(--band-a-ink);
  }

  [data-band='error'] {
    --band: var(--band-b);
    --band-ink: var(--band-b-ink);
  }

  [data-band='warning'] {
    --band: oklch(from var(--p1) calc(0.5 + var(--theme) * 0.03) 0.1 h);
  }

  [data-band='info'] {
    --band: oklch(from var(--p3) calc(0.47 + var(--theme) * 0.03) 0.1 h);
  }

  [data-band='help'] {
    --band: oklch(from var(--p4) calc(0.47 + var(--theme) * 0.03) 0.1 h);
  }

  [data-band='warning'],
  [data-band='info'],
  [data-band='help'] {
    --band-ink: oklch(from var(--band) 0.975 0.01 h);
  }

  [data-band] {
    --text: var(--band-ink);
    --text-muted: color-mix(in oklch, var(--band-ink) 88%, transparent);
    --dg-ground: var(--band);
    /* how deep its edges may cut, from its top and from its foot: past
       any wide band's height, so a wide band is cut as its outline
       stretched over it, and shallow where a band stacks and grows tall */
    --reach: 100rem;
    background: var(--band);
    color: var(--band-ink);
    clip-path: var(--clip);
  }

  @supports (clip-path: shape(from 0 0, line to 0 0)) {
    [data-band] {
      clip-path: var(--outline);
    }
  }

  .edge {
    position: absolute;
  }

  /* the plate keeps room enough for a diagram's labels beside the words */
  [data-band] .pair {
    grid-template-columns: minmax(0, 7fr) minmax(22rem, 5fr);
    padding-block: 0;
  }

  [data-band] .pair.flip {
    grid-template-columns: minmax(22rem, 5fr) minmax(0, 7fr);
  }

  .plate {
    container-type: inline-size;
    justify-self: center;
    width: 100%;
    max-width: 30rem;
  }

  /* a diagram's labels are sized in its own units, which shrink with its
     plate; a small plate sets them larger, so they still read */
  @container (width < 440px) {
    .plate :global(.dg .kind) {
      font-size: 10.5px;
    }

    .plate :global(.dg .name) {
      font-size: 15px;
    }

    .plate :global(.dg .say) {
      font-size: 12.5px;
    }

    .plate :global(.dg .code) {
      font-size: 11px;
    }
  }

  /* a band's words stand over its icon, which lies behind them */
  [data-band] > .wrap {
    position: relative;
    z-index: 1;
  }

  /* on a band, the cells are the band's own light ink, a veil of it, and
     a field an opaque tint of it; a tick fills with that ink */
  [data-band] :global(.actions) {
    --fill: var(--band-ink);
    --on-fill: var(--band);
    --fill-on: color-mix(in oklch, var(--band-ink) 88%, var(--band));
    --wash: color-mix(in oklch, var(--band-ink) 22%, transparent);
    --on-wash: var(--band-ink);
    --plain: color-mix(in oklch, var(--band-ink) 18%, var(--band));
    --plain-on: color-mix(in oklch, var(--band-ink) 26%, var(--band));
    --on-plain: var(--band-ink);
  }

  [data-band] :global(.check) {
    --check-fill: var(--band-ink);
    --check-tick: var(--band);
  }

  blockquote {
    display: grid;
    gap: 1.6rem;
    max-width: 54rem;
    margin: 0;
  }

  .said :global(p) {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 3.1rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .said :global(strong) {
    font-weight: 760;
  }

  /* the quote's opening mark, as a pull quote wears one: large and faint
     in the band's light ink, over its first line and hanging a little
     past its edge, as print hangs it, out of the words and hidden from a
     screen reader */
  .said {
    position: relative;
  }

  .mark {
    position: absolute;
    top: 0;
    left: clamp(-1.9rem, -2.6vw, -0.9rem);
    width: clamp(4rem, 8vw, 7rem);
    height: auto;
    fill: var(--band-ink);
    opacity: 0.16;
    pointer-events: none;
    transform: translateY(-90%) rotate(180deg);
  }

  cite {
    color: inherit;
    font-style: normal;
    opacity: 0.75;
  }

  @media (max-width: 56rem) {
    .pair,
    .pair.flip,
    [data-band] .pair,
    [data-band] .pair.flip {
      grid-template-columns: minmax(0, 1fr);
    }

    [data-band] {
      --reach: 28rem;
    }

    .pair.flip > :global(figure),
    .pair.flip > .plate {
      order: 0;
    }

    .single.flip .copy,
    .single.flip blockquote {
      margin-left: 0;
    }

    .overhang {
      margin-bottom: 0;
    }
  }
</style>
