---
// A list as cells (index.md, the layout): its items, each a `Cell`, the
// cells taking the five inks in turn however many there are, leaving out
// the one `skip` names, as a band's own, and numbered where `numbered`.
// Its items are its `items`, as a section's frontmatter gives them, or its
// slot, the `Cell`s a body writes inline. Its `layout`, a section's
// `arrange` or the body's own: `column`, down the page, unset; `row`,
// side by side, each cell over its words; `grid`, two columns, each cell
// beside them.
import { inline } from '../lib/inline'
import { STATUSES, type Status } from '../schemas'
import Cell from './Cell.astro'

interface Props {
  items?: { title: string; body: string; icon?: string; photo?: string }[]
  numbered?: boolean
  seed?: number
  drafted?: true
  // an ink the cells leave out, as a band's own, so none sinks into it
  skip?: Status
  layout?: 'column' | 'row' | 'grid'
  // the same, as a body writes it, in its section's words
  arrange?: 'column' | 'row' | 'grid'
}

const { items, numbered = false, seed = 1, drafted, skip, layout, arrange } = Astro.props
// the turn of inks, by the item's place, as custom properties the cells
// read by their place in the list
const inks = STATUSES.map((_, i) => i).filter((i) => STATUSES[i] !== skip)
const turn = Object.fromEntries(inks.map((p, k) => [`--c${k}`, `var(--p${p})`]))
---

<ul class="cells" data-layout={layout ?? arrange ?? 'column'} data-cycle={inks.length} data-numbered={numbered ? '' : undefined} style={turn} role="list" data-drafted={drafted}>
  {
    items
      ? items.map((it, i) => (
          <Cell title={it.title} icon={it.icon} photo={it.photo} seed={seed * 13 + i * 7}>
            <Fragment set:html={inline(it.body)} />
          </Cell>
        ))
      : <slot />
  }
</ul>

<style>
  /* a readable measure, near the lede's above it */
  .cells {
    display: grid;
    gap: 1.6rem;
    max-width: 34rem;
    margin: 0.75rem 0 1.25rem;
    padding: 0;
    list-style: none;
    counter-reset: cell;
  }

  /* each cell's ink, its place in the turn of five, or of four on a band */
  [data-cycle='5'] > :global(.item:nth-child(5n + 1)) { --ink: var(--c0); }
  [data-cycle='5'] > :global(.item:nth-child(5n + 2)) { --ink: var(--c1); }
  [data-cycle='5'] > :global(.item:nth-child(5n + 3)) { --ink: var(--c2); }
  [data-cycle='5'] > :global(.item:nth-child(5n + 4)) { --ink: var(--c3); }
  [data-cycle='5'] > :global(.item:nth-child(5n)) { --ink: var(--c4); }
  [data-cycle='4'] > :global(.item:nth-child(4n + 1)) { --ink: var(--c0); }
  [data-cycle='4'] > :global(.item:nth-child(4n + 2)) { --ink: var(--c1); }
  [data-cycle='4'] > :global(.item:nth-child(4n + 3)) { --ink: var(--c2); }
  [data-cycle='4'] > :global(.item:nth-child(4n)) { --ink: var(--c3); }

  /* side by side, as many to a row as fit, each its cell over its words */
  [data-layout='row'] {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2rem 2.2rem;
    max-width: none;
  }

  /* two columns, each its cell beside its words, one on a narrow screen */
  [data-layout='grid'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 1.6rem;
    max-width: none;
  }

  @media (max-width: 40rem) {
    [data-layout='grid'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
