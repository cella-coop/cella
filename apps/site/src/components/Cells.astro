---
// A list as cells (index.md, the layout): each item a lone cell of the
// brand beside its title and line, the cells taking the five inks in
// turn however many there are, leaving out the one `skip` names, as a
// band's own. A cell may hold the item's number, when
// the list is `numbered`, or its Phosphor icon, `icon`, in the regular
// weight, drawn in the paper on the ink; else it is bare. Its `layout`,
// a section's `arrange`:
// `column`, down the page, unset; `row`, side by side, each cell over its
// words; `grid`, two columns, each cell beside them.
import { cell } from '@cella/brand'
import { glyphPaths } from '../lib/icon'
import { STATUSES, type Status } from '../schemas'

interface Props {
  items: { title: string; body: string; icon?: string }[]
  numbered?: boolean
  seed?: number
  drafted?: true
  // an ink the cells leave out, as a band's own, so none sinks into it
  skip?: Status
  // how the items stand: down the page, side by side, each its cell over
  // its words, or in two columns, each its cell beside them
  layout?: 'column' | 'row' | 'grid'
}

const { items, numbered = false, seed = 1, drafted, skip, layout = 'column' } = Astro.props
const inks = STATUSES.map((_, i) => i).filter((i) => STATUSES[i] !== skip)
---

<ul class="cells" data-layout={layout} role="list" data-drafted={drafted}>
  {
    items.map((it, i) => (
      <li class="item">
        <svg class="mark" viewBox="0 0 100 100" aria-hidden="true" style={{ '--ink': `var(--p${inks[i % inks.length]})` }}>
          <path class="shape" d={cell(seed * 13 + i * 7)} />
          {numbered && <text class="n" x="50" y="50">{i + 1}</text>}
          {!numbered && it.icon && <g class="icon" transform="translate(27 27) scale(0.18)" set:html={glyphPaths(it.icon)} />}
        </svg>
        <div>
          <h3>{it.title}</h3>
          <p>{it.body}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  /* a readable measure, near the lede's above it */
  .cells {
    display: grid;
    gap: 1.6rem;
    max-width: 34rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  /* side by side, as many to a row as fit, each its cell over its words */
  [data-layout='row'] {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2rem 2.2rem;
    max-width: none;
  }

  [data-layout='row'] .item {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }

  /* two columns, each its cell beside its words, one on a narrow screen */
  [data-layout='grid'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.4rem;
    max-width: none;
  }

  @media (max-width: 40rem) {
    [data-layout='grid'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .mark {
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
  }

  .shape {
    fill: var(--ink);
  }

  .n {
    fill: oklch(0.985 0.004 250);
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .icon {
    fill: oklch(0.985 0.004 250);
  }

  p {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.97rem;
  }
</style>
