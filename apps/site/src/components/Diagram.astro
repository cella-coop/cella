---
// A diagram of @cella/diagrams by its name, in a figure with the mark
// every diagram wears: a sparkle and the words saying a model made it,
// at the screen's edge on the diagram's outer side, `edge`, the sparkle
// outermost. On the paper its particles take the status tones; on a
// band, `band`, it is the band's light ink alone, its shapes and glyphs
// carrying what the tones would.
import { diagrams, type DiagramName } from '@cella/diagrams'
import { iconMarkup } from '../lib/icon'
import { siteData } from '../lib/text'

const { name, band = false, edge = 'r' } = Astro.props as { name: DiagramName; band?: boolean; edge?: 'l' | 'r' }
const diagram = Object.hasOwn(diagrams, name) ? diagrams[name] : undefined
if (!diagram) {
  throw new Error(name)
}
const { component: Picture, meta } = diagram
const site = await siteData()
---

<figure class:list={['diagram', { band }]} data-edge={edge}>
  <div role="img" aria-label={meta.alt}><Picture /></div>
  <figcaption><span>{site.diagram.mark}</span><span class="spark" set:html={iconMarkup('sparkle', 'current')} /></figcaption>
</figure>

<style>
  .diagram {
    --dg-grant: var(--success-text);
    --dg-no: var(--error-text);
    --dg-ask: var(--help-text);
    margin: 2rem 0;
  }

  .band {
    --dg-grant: currentColor;
    --dg-no: currentColor;
    --dg-ask: currentColor;
    margin: 0;
  }

  /* the mark runs out to the screen's edge on the diagram's outer side */
  figcaption {
    --bleed: calc((100vw - min(100vw, var(--wrap))) / 2 + max(16px, env(safe-area-inset-right, 0px)));
    --edge: max(16px, env(safe-area-inset-right, 0px));
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  [data-edge='r'] figcaption {
    justify-content: flex-end;
    margin-right: calc(-1 * var(--bleed));
    padding-right: var(--edge);
  }

  [data-edge='l'] figcaption {
    flex-direction: row-reverse;
    justify-content: flex-end;
    margin-left: calc(-1 * var(--bleed));
    padding-left: var(--edge);
  }

  .spark {
    display: inline-flex;
    flex: none;
    width: 1.05em;
    height: 1.05em;
  }

  .band figcaption {
    color: inherit;
    font-size: var(--t-xs);
    opacity: 0.75;
  }
</style>
