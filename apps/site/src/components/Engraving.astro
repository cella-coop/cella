---
// A figure (index.md, figures): a photo engraved in one of the five inks,
// laid on the print's paper washed with that ink and cut into a cluster
// of the brand's cells, the largest holding what the photo is of, which
// runs off the screen's edge on the side it bleeds to. Under it, its
// caption and its photographer's credit.
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import { cluster } from '@cella/brand'
import type { Figure, Status } from '../schemas'
import { focusIn } from '../lib/focus'
import type { Marks } from '../lib/text'
import Cut from './Cut.astro'

interface Props {
  figure: Figure
  ink: Status
  seed: number
  bleed?: 'l' | 'r'
  aspect?: number
  credit: { template: string; unsplash: string }
  drafted: Marks
}

const { figure, ink, seed, bleed, aspect = 1.25, credit, drafted } = Astro.props
const w = 1000
const h = Math.round(w / aspect)
const gutter = 12
const cut = (height: number, side: 'l' | 'r' | undefined, focus: Awaited<ReturnType<typeof focusIn>>) =>
  cluster(w, height, { pitch: 115, gutter, round: 16, seed, drop: 0.25, bleed: side, focus })
const cells = cut(h, bleed, await focusIn(figure.photo, w, h))
// stacked under its words, a figure takes the column's whole width, so
// it is cut a second time, wider than tall, lest it fill the screen, and
// bleeding right, as the hero's does; the narrow layout shows that cut
const NARROW = 1.9
const hn = Math.round(w / NARROW)
const narrow = cut(hn, 'r', await focusIn(figure.photo, w, hn))
// the band of the box the cells fill, so no empty paper stands between
// the cells and the caption
const band = (paths: string[], height: number) => {
  const ys = paths.flatMap((d) => (d.match(/-?\d+(?:\.\d+)?/g) ?? []).map(Number).filter((_, k) => k % 2 === 1))
  const top = Math.max(0, Math.floor(Math.min(...ys) - gutter))
  const foot = Math.min(height, Math.ceil(Math.max(...ys) + gutter))
  return { top, tall: foot - top }
}
const [wide, slim] = ['wide', 'narrow'] as const
const id = `cells-${figure.photo}-${seed}`
const meta = JSON.parse(readFileSync(join(process.cwd(), 'src/photos', `${figure.photo}.json`), 'utf8')) as { photographer: string; photographerUrl: string; photoUrl: string }
const [before, rest = ''] = credit.template.split('{name}')
const [between, after = ''] = rest.split('{unsplash}')
---

<figure class="engraving" data-bleed={bleed} data-turns>
  <Cut photo={figure.photo} ink={ink} cells={cells} w={w} h={h} {...band(cells, h)} id={id} label={figure.alt ?? figure.caption} fit={wide} />
  <Cut photo={figure.photo} ink={ink} cells={narrow} w={w} h={hn} {...band(narrow, hn)} id={`${id}-n`} label={figure.alt ?? figure.caption} fit={slim} />
  <figcaption>
    <span class="caption" data-drafted={drafted('figure.caption')}>{figure.caption}</span>
    <span class="credit">{before}<a href={meta.photographerUrl}>{meta.photographer}</a>{between}<a href={meta.photoUrl}>{credit.unsplash}</a>{after}</span>
  </figcaption>
</figure>

<style>
  .engraving {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
    margin: 0;
  }

  /* the caption over the credit, quiet: the caption in the display face,
     the credit a small spaced label */
  figcaption {
    display: grid;
    gap: 0.3rem;
    color: var(--text-subtle);
    opacity: 0.85;
  }

  .caption {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .credit {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  figcaption a {
    color: inherit;
  }

  /* a credit's link is small type; its padding gives a finger room
     without moving a line */
  .credit a {
    padding-block: 16px;
  }

  /* bleeding, the figure runs past the column to the screen's edge on its
     outer side, and its caption stands toward that edge, a gutter in from
     it and never more than 5rem past the column, so a wide screen keeps
     it by the cells */
  [data-bleed] {
    --bleed: calc((100vw - min(100vw, var(--wrap))) / 2 + max(16px, env(safe-area-inset-right, 0px)));
    --edge: max(16px, env(safe-area-inset-right, 0px));
    --inset: max(var(--edge), calc(var(--bleed) - 5rem));
  }

  [data-bleed='r'] {
    margin-right: calc(-1 * var(--bleed));
  }

  [data-bleed='r'] figcaption {
    justify-items: end;
    padding-right: var(--inset);
    text-align: right;
  }

  [data-bleed='l'] {
    margin-left: calc(-1 * var(--bleed));
  }

  [data-bleed='l'] figcaption {
    justify-items: start;
    padding-left: var(--inset);
  }

  .engraving > :global([data-fit='narrow']) {
    display: none;
  }

  /* stacked under its words (Block.astro's breakpoint), a figure wears
     its second cut, wider than tall, and bleeds right */
  @media (max-width: 56rem) {
    [data-turns] > :global([data-fit='wide']) {
      display: none;
    }

    [data-turns] > :global([data-fit='narrow']) {
      display: block;
    }

    [data-turns][data-bleed='l'] {
      margin-right: calc(-1 * var(--bleed));
      margin-left: 0;
    }

    [data-turns][data-bleed='l'] figcaption {
      justify-items: end;
      padding-right: var(--inset);
      padding-left: 0;
      text-align: right;
    }
  }
</style>
