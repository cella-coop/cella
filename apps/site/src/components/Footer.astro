---
// The footer, on the page's own paper and its grid, one centred column:
// the lockup in one ink, the text's, over the site's closing line, then
// the sitemap in columns, each a heading over its links, and under it the
// note that the site shows prototype work.
import lockup from '@cella/brand/lockup.svg?raw'
import type { Marks } from '../lib/text'

type Link = { label: string; href: string }
interface Props {
  footer: { line: string; columns: { heading: string; links: Link[] }[]; disclaimer: string }
  drafted: Marks
}

const { footer, drafted } = Astro.props
---

<footer class="footer">
  <div class="wrap">
    <div class="brand">
      <span class="lockup" aria-hidden="true" set:html={lockup} />
      <p data-drafted={drafted('footer.line')}>{footer.line}</p>
    </div>
    <nav class="map" data-drafted={drafted('footer.columns')}>
      {
        footer.columns.map((c) => (
          <div>
            <p class="label">{c.heading}</p>
            <ul role="list">
              {c.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <p class="disclaimer" data-drafted={drafted('footer.disclaimer')}>{footer.disclaimer}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-top: clamp(9rem, 18vw, 16rem);
    padding-block: 3.5rem 3rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    text-align: center;
  }

  .wrap {
    display: grid;
    justify-items: center;
    gap: 3rem;
  }

  .brand {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  /* the lockup in the text's ink alone, its mark's five inks put by */
  .lockup {
    display: flex;
    color: var(--text);
  }

  .lockup :global(svg) {
    width: auto;
    height: 1.4rem;
  }

  .lockup :global(path) {
    fill: currentColor;
  }

  .brand p {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .map {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem clamp(2.5rem, 7vw, 5.5rem);
  }

  .map ul {
    display: grid;
    gap: 0.55rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .map a {
    color: var(--text);
    text-decoration: none;
  }

  .map a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .disclaimer {
    max-width: 40rem;
    color: var(--text-subtle);
    font-size: 0.82rem;
  }
</style>
