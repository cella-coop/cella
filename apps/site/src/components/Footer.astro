---
// The footer, on the coral band a call to action runs into: the brand's
// mark, the site's closing line and its links.
import mark from '@cella/brand/mark.svg?raw'
import type { Marks } from '../lib/text'

type Link = { label: string; href: string }
interface Props {
  footer: { line: string; links: Link[] }
  drafted: Marks
}

const { footer, drafted } = Astro.props
---

<footer class="footer">
  <div class="wrap bar">
    <span class="mark" aria-hidden="true" set:html={mark} />
    <p class="label line" data-drafted={drafted('footer.line')}>{footer.line}</p>
    {
      footer.links.length > 0 && (
        <ul class="links" role="list" data-drafted={drafted('footer.links')}>
          {footer.links.map((l) => (
            <li>
              <a class="label" href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding-block: 2rem 3rem;
    background: var(--band-b);
    color: var(--band-b-ink);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.5rem;
  }

  .mark :global(svg) {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
  }

  .label {
    color: inherit;
    opacity: 0.8;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    opacity: 1;
  }
</style>
