---
// The footer, on the page's own paper and its grid, one centred column:
// the lockup in one ink, the text's, over the site's closing line, then
// the header's links in a row, the home page's first, and under them the
// note that the site shows prototype work.
import lockup from '@cella/brand/lockup.svg?raw'
import type { Marks } from '../lib/text'

type Link = { label: string; href: string }
interface Props {
  footer: { line: string; home: string; disclaimer: string }
  nav: Link[]
  drafted: Marks
}

const { footer, nav, drafted } = Astro.props
const home = '/'
---

<footer class="footer">
  <div class="wrap">
    <div class="brand">
      <span class="lockup" aria-hidden="true" set:html={lockup} />
      <p data-drafted={drafted('footer.line')}>{footer.line}</p>
    </div>
    <nav class="map">
      <ul role="list">
        <li><a href={home} data-drafted={drafted('footer.home')}>{footer.home}</a></li>
        {
          nav.map((l) => (
            <li>
              <a href={l.href} data-drafted={drafted('nav')}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="disclaimer" data-drafted={drafted('footer.disclaimer')}>{footer.disclaimer}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-top: clamp(9rem, 18vw, 16rem);
    padding-block: 3.5rem 3rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    text-align: center;
  }

  .wrap {
    display: grid;
    justify-items: center;
    gap: 3rem;
  }

  .brand {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  /* the lockup in the text's ink alone, its mark's five inks put by */
  .lockup {
    display: flex;
    color: var(--text);
  }

  .lockup :global(svg) {
    width: auto;
    height: 1.4rem;
  }

  .lockup :global(path) {
    fill: currentColor;
  }

  .brand p {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .map ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem clamp(2rem, 5vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* each link a finger's 44px tall */
  .map a {
    display: inline-block;
    padding: 11px 0.25rem;
    color: var(--text);
    text-decoration: none;
  }

  .map a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .disclaimer {
    max-width: 28rem;
    margin-block: 1.5rem 1rem;
    color: var(--text-subtle);
    font-family: var(--font-display);
    font-size: 0.88rem;
    line-height: 1.55;
  }
</style>
