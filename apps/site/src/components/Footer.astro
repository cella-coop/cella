---
// The footer, on the page's own paper and its grid: the sign-up for news,
// then the lockup and
// the site's closing line, the sitemap in columns, each a heading over
// its links, and under them the note that the site shows prototype work.
import lockup from '@cella/brand/lockup.svg?raw'
import type { Marks } from '../lib/text'
import Signup from './Signup.astro'

type Link = { label: string; href: string }
interface Props {
  footer: { line: string; columns: { heading: string; links: Link[] }[]; disclaimer: string }
  signup: Parameters<typeof Signup>[0]['text']
  drafted: Marks
}

const { footer, signup, drafted } = Astro.props
---

<footer class="footer">
  <div class="wrap">
    <div class="news">
      <Signup text={signup} ink={'error'} drafted={drafted} />
    </div>
    <div class="top">
      <div class="brand">
        <span class="lockup" aria-hidden="true" set:html={lockup} />
        <p data-drafted={drafted('footer.line')}>{footer.line}</p>
      </div>
      <nav class="map" data-drafted={drafted('footer.columns')}>
        {
          footer.columns.map((c) => (
            <div>
              <p class="label">{c.heading}</p>
              <ul role="list">
                {c.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <p class="disclaimer" data-drafted={drafted('footer.disclaimer')}>{footer.disclaimer}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-block: 3.5rem 3rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .news {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
  }

  .brand {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .lockup {
    display: flex;
    color: var(--text);
  }

  .lockup :global(svg) {
    width: auto;
    height: 1.4rem;
  }

  .brand p {
    max-width: 22rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .map {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 2rem;
  }

  .map ul {
    display: grid;
    gap: 0.55rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .map a {
    color: var(--text);
    text-decoration: none;
  }

  .map a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .disclaimer {
    max-width: 44rem;
    margin-top: 3.5rem;
    color: var(--text-subtle);
    font-size: 0.82rem;
  }

  @media (max-width: 56rem) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
