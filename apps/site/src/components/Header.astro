---
// The header, sticky at the top on a pane of glass with the paper's grain
// in it: the brand's lockup linking home, the site's links, and the theme
// toggle, an icon alone in the bar's far corner.
import lockup from '@cella/brand/lockup.svg?raw'
import { iconMarkup } from '../lib/icon'
import ThemeToggle from './ThemeToggle.astro'

type Link = { label: string; href: string }
interface Props {
  title: string
  nav: Link[]
  toggle: string
  menu: string
  home?: string
}

const { title, nav, toggle, menu, home = '/' } = Astro.props
const here = Astro.url.pathname.replace(/\/$/, '')
const current = (href: string) => {
  const to = href.replace(/\/$/, '')
  return to !== '' && (here === to || here.startsWith(`${to}/`))
}
---

<header class="header">
  <div class="wrap bar">
    <a class="home" href={home} aria-label={title} set:html={lockup} />
    <nav aria-label={title}>
      {
        nav.map((l) => (
          <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="tools">
      {
        nav.length > 0 && (
          <details class="menu">
            <summary aria-label={menu} set:html={iconMarkup('list', 'accent')} />
            <nav aria-label={menu}>
              {nav.map((l) => (
                <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
              ))}
            </nav>
          </details>
        )
      }
    </div>
  </div>
  <div class="corner">
    <ThemeToggle label={toggle} bare />
  </div>
</header>

<script>
  // The menu opens and closes as a <details> with no script; with one, a
  // press outside it or Escape closes it too, Escape handing focus back
  // to its button
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.menu')) {
    document.addEventListener('pointerdown', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) {
        menu.open = false
      }
    })
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false
        menu.querySelector('summary')?.focus()
      }
    })
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: var(--glass);
    background-image: var(--grain-panel);
    backdrop-filter: blur(8px) saturate(1.2);
    -webkit-backdrop-filter: blur(8px) saturate(1.2);
  }

  /* the bar reaches 2rem past the content on each side, and keeps clear
     of the corner where it reaches it */
  .bar {
    --reach: calc(var(--wrap) + 4rem);
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: var(--reach);
    height: 4.2rem;
    padding-right: max(16px, calc(4rem - (100vw - min(100vw, var(--reach))) / 2));
  }

  /* The theme toggle, in the bar's far corner */
  .corner {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    transform: translateY(-50%);
  }

  /* the lockup, the menu's links and the bar's two buttons each a
     finger's 44px tall */
  .home {
    display: flex;
    padding-block: 11px;
    color: var(--text);
  }

  .corner :global(.toggle) {
    width: 44px;
    height: 44px;
    padding: 11px;
  }

  .home :global(svg) {
    width: auto;
    height: 1.55rem;
  }

  .bar > nav {
    display: flex;
    gap: 1.8rem;
    margin-inline-start: auto;
  }

  .bar > nav a {
    padding-block: 11px;
  }

  /* On a narrow screen the links fold into a menu under a list icon */
  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 11px;
    border-radius: var(--radius-control);
    cursor: pointer;
    list-style: none;
  }

  .menu summary:hover {
    background: var(--hover);
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu[open] summary {
    background: var(--hover);
  }

  .menu nav {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    display: grid;
    min-width: 12rem;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow-float);
  }

  .menu nav a {
    padding: 0.75rem;
    border-radius: var(--radius-control);
  }

  .menu nav a:hover {
    background: var(--hover);
  }

  nav a {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 120ms var(--ease);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 48rem) {
    .bar > nav {
      display: none;
    }

    .menu {
      display: block;
    }

    .tools {
      margin-inline-start: auto;
    }
  }
</style>
