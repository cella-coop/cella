---
// A heading, its part marked `*so*` set thin, broken where its text
// breaks a line.
import { parts } from '../lib/text'

interface Props {
  text: string
  level: 1 | 2
  drafted?: true
}

const { text, level, drafted } = Astro.props
const Tag = level === 1 ? 'h1' : 'h2'
---

<Tag data-drafted={drafted}>{parts(text).map((p) => (p.thin ? <span class="thin">{p.text}</span> : p.text))}</Tag>

<style>
  /* a line break the text writes, `\n`, breaks the heading there */
  h1,
  h2 {
    white-space: pre-line;
  }
</style>
