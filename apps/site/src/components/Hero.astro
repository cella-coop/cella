---
// The hero: an eyebrow, the page's heading and its lede, its two actions,
// and its print or its figure, on a band of its tone. A print fills the
// hero's far side, top to foot, in the band's tone, the band's colour
// flowing over its near edge in the mark's cells, the words on the band
// beside it; on a narrow screen it stands above them. A figure, named
// without a print, stands beside the words on a card; with a print, the
// print alone shows.
import Art from './Art.astro'
import Button from './Button.astro'
import Showcase from './Showcase.astro'
import type { Status } from '../lib/photo'

type Shown = string | { photo: string; ink?: Status }

type Link = { label: string; href: string }
interface Props {
  hero: {
    eyebrow?: string
    heading: string
    lede?: string
    primary?: Link
    secondary?: Link
    figure?: { diagram: string } | { photo: string; alt: string; print?: string }
    backdrop?: Shown
  }
  size?: 'large' | 'small'
  tone: Status
}

const { hero, size = 'large', tone } = Astro.props
const art = hero.backdrop
const named = typeof art === 'string' ? art : art?.photo
const layout = art ? 'art' : hero.figure ? 'figure' : 'plain'
---

<section class="hero band" id="top" data-layout={layout} data-size={size} style={{ '--tone': `var(--tone-${tone})` }}>
  {art && <Art photo={art} tone={tone} side={'end'} key={`hero-${named}`} />}
  <div class="wrap grid">
    <div class="copy">
      {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
      <h1>{hero.heading}</h1>
      {hero.lede && <p class="lede">{hero.lede}</p>}
      {
        (hero.primary || hero.secondary) && (
          <div class="actions">
            {hero.primary && <Button href={hero.primary.href}>{hero.primary.label}</Button>}
            {hero.secondary && (
              <Button href={hero.secondary.href} variant={'secondary'}>
                {hero.secondary.label}
              </Button>
            )}
          </div>
        )
      }
    </div>
    {
      layout === 'figure' && hero.figure && (
        <div class="card">
          <Showcase figure={hero.figure} />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(4rem, 12vh, 8rem) clamp(3rem, 9vh, 6rem);
    overflow: hidden;
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  /* With a print: the print fills the far side, the words the near */
  .hero[data-layout='art'] {
    display: flex;
    align-items: center;
    min-height: clamp(32rem, 82vh, 52rem);
  }

  .hero[data-layout='art'][data-size='small'] {
    min-height: clamp(24rem, 56vh, 36rem);
  }

  /* the words in the near half, a gap short of the print */
  .hero[data-layout='art'] .copy {
    max-width: 34rem;
    width: calc(50% - 3rem);
  }

  /* With a figure: the figure on a card beside the words */
  .hero[data-layout='figure'] .grid {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }

  .card {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .card :global(figure) {
    margin: 0;
  }

  /* Plain: the words centred */
  .hero[data-layout='plain'] .copy {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  .hero[data-layout='plain'] .lede {
    margin-inline: auto;
  }

  .hero[data-layout='plain'] .actions {
    justify-content: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(var(--t-4xl), 6vw, calc(var(--t-4xl) * 2));
  }

  .hero[data-size='small'] {
    padding-block: clamp(3rem, 9vh, 5.5rem) clamp(2rem, 6vh, 3.5rem);
  }

  .hero[data-size='small'] h1 {
    font-size: clamp(var(--t-3xl), 4.5vw, calc(var(--t-4xl) * 1.4));
  }

  .lede {
    margin: 1.5rem 0 0;
    max-width: 36rem;
    color: var(--text-muted);
    font-size: var(--t-xl);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* A narrow screen: the print above, the words under it */
  @media (max-width: 56rem) {
    .hero[data-layout='art'] {
      display: block;
      min-height: 0;
      padding-top: 0;
    }

    .hero[data-layout='art'] .grid {
      margin-top: 1.5rem;
    }

    .hero[data-layout='art'] .copy {
      width: auto;
      max-width: none;
    }

    .hero[data-layout='figure'] .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
