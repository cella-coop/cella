---
// The hero: an eyebrow, the page's heading and its lede, its two actions,
// and beside them its print, a panel of a photo in the house's print, with
// the figure it names on a card over it, or either alone; the brand's five
// inks under it.
import Button from './Button.astro'
import Backdrop from './Backdrop.astro'
import Showcase from './Showcase.astro'
import type { Status } from '../lib/photo'

type Shown = string | { photo: string; ink?: Status }

type Link = { label: string; href: string }
interface Props {
  hero: {
    eyebrow?: string
    heading: string
    lede?: string
    primary?: Link
    secondary?: Link
    figure?: { diagram: string } | { photo: string; alt: string; print?: string }
    backdrop?: Shown
  }
  size?: 'large' | 'small'
}

const { hero, size = 'large' } = Astro.props
---

<section class="hero" id="top" data-figure={hero.figure || hero.backdrop ? 'yes' : 'no'} data-size={size}>
  <div class="wrap grid">
    <div class="copy">
      {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
      <h1>{hero.heading}</h1>
      {hero.lede && <p class="lede">{hero.lede}</p>}
      {
        (hero.primary || hero.secondary) && (
          <div class="actions">
            {hero.primary && <Button href={hero.primary.href}>{hero.primary.label}</Button>}
            {hero.secondary && (
              <Button href={hero.secondary.href} variant={'secondary'}>
                {hero.secondary.label}
              </Button>
            )}
          </div>
        )
      }
    </div>
    {
      (hero.figure || hero.backdrop) && (
        <div class="side" data-print={hero.backdrop ? 'yes' : 'no'} data-card={hero.figure ? 'yes' : 'no'}>
          {hero.backdrop && <Backdrop photo={hero.backdrop} />}
          {hero.figure && (
            <div class="card">
              <Showcase figure={hero.figure} />
            </div>
          )}
        </div>
      )
    }
  </div>
  <div class="inks" aria-hidden="true"><i /><i /><i /><i /><i /></div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(4rem, 12vh, 8rem) clamp(3rem, 9vh, 6rem);
    overflow: hidden;
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero[data-figure='yes'] .grid {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }

  .hero[data-figure='no'] .copy {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(var(--t-4xl), 6vw, calc(var(--t-4xl) * 2));
  }

  .hero[data-size='small'] {
    padding-block: clamp(3rem, 9vh, 5.5rem) clamp(2rem, 6vh, 3.5rem);
  }

  .hero[data-size='small'] h1 {
    font-size: clamp(var(--t-3xl), 4.5vw, calc(var(--t-4xl) * 1.4));
  }

  .hero[data-size='small'] .inks {
    display: none;
  }

  .lede {
    margin: 1.5rem 0 0;
    max-width: 36rem;
    color: var(--text-muted);
    font-size: var(--t-xl);
  }

  .hero[data-figure='no'] .lede {
    margin-inline: auto;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero[data-figure='no'] .actions {
    justify-content: center;
  }

  .side :global(figure) {
    margin: 0;
  }

  /* The print is a panel, a picture with its own paper; the figure sits
     on a card over its lower corner */
  .side[data-print='yes'] {
    position: relative;
    min-height: 22rem;
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(2.5rem, 6vw, 4rem) clamp(2rem, 5vw, 4rem);
    border-radius: calc(var(--radius) * 1.5);
    overflow: hidden;
  }

  .side[data-print='yes'][data-card='no'] {
    aspect-ratio: 4 / 3;
    min-height: 0;
  }

  .card {
    position: relative;
    z-index: 1;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius) 0 0 var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow-float);
  }

  .side[data-print='no'] .card {
    border-radius: var(--radius);
  }

  .inks {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    height: 3px;
  }

  .inks i {
    flex: 1;
  }

  .inks i:nth-child(1) {
    background: var(--p0);
  }

  .inks i:nth-child(2) {
    background: var(--p1);
  }

  .inks i:nth-child(3) {
    background: var(--p2);
  }

  .inks i:nth-child(4) {
    background: var(--p3);
  }

  .inks i:nth-child(5) {
    background: var(--p4);
  }

  @media (max-width: 56rem) {
    .hero[data-figure='yes'] .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
