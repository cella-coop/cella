---
// A list (index.md, the lists): its items, each an `Item`, taking the
// five inks in turn however many there are, or on a band the four it
// hands down, leaving out its own, and counted where `numbered`. The
// turn's start and order are its own, drawn from `seed`, or, unset, from
// its words, so two lists rarely match and one is the same on every
// build. Its
// items are its `items`, or its slot, the `Item`s a page writes inline.
// Its `layout`:
//   `column`, unset: cells down the page, each beside its words;
//   `row`: cells side by side, each over its words, as many as fit;
//   `grid`: cells in two columns, each beside its words;
//   `ruled`: no cells, a title and its words in two columns every row
//     shares, a rule under each;
//   `steps`: no cells, a large numeral in the item's ink over its title
//     and words, in two columns.
import { inline } from '../lib/inline'
import { seedOf, shuffled } from '../lib/place'
import Item from './Item.astro'

export type Layout = 'column' | 'row' | 'grid' | 'ruled' | 'steps'

interface Props {
  items?: { title: string; body: string; icon?: string; photo?: string }[]
  layout?: Layout
  numbered?: boolean
  seed?: number
  drafted?: true
}

const { items, layout = 'column', numbered = false, drafted } = Astro.props
// an inline list's items, rendered once, both to show and to seed it, by
// their words alone: the dev server marks its tags, a build does not
const written = items ? undefined : await Astro.slots.render('default')
const words = items ? items.map((it) => it.title).join('\n') : (written ?? '').replace(/<[^>]*>/g, '')
const seed = Astro.props.seed ?? seedOf(words)
// the turn this list takes: the five inks, or the band's four, in its order
const turn = Object.fromEntries([
  ...shuffled(5, seed).map((k, i) => [`--q${i}`, `var(--p${k})`]),
  ...shuffled(4, seed + 1).map((k, i) => [`--c${i}`, `var(--b${k})`]),
])
---

<ul class="list" data-layout={layout} data-numbered={numbered ? '' : undefined} role="list" data-drafted={drafted} style={turn}>
  {
    items
      ? items.map((it, i) => (
          <Item title={it.title} icon={it.icon} photo={it.photo} seed={seed * 13 + i * 7}>
            <Fragment set:html={inline(it.body)} />
          </Item>
        ))
      : <Fragment set:html={written} />
  }
</ul>

<style>
  /* a readable measure, near the lede's above it */
  .list {
    display: grid;
    gap: 1.6rem;
    max-width: 34rem;
    margin: 2rem 0 2.25rem;
    padding: 0;
    list-style: none;
    counter-reset: item;
  }

  /* each item's ink, its place in the list's turn of five, --q0 to --q4;
     on a band, of the four the band hands down, its own left out, in the
     list's order, --c0 to --c3 */
  .list > :global(.item:nth-child(5n + 1)) { --ink: var(--q0); }
  .list > :global(.item:nth-child(5n + 2)) { --ink: var(--q1); }
  .list > :global(.item:nth-child(5n + 3)) { --ink: var(--q2); }
  .list > :global(.item:nth-child(5n + 4)) { --ink: var(--q3); }
  .list > :global(.item:nth-child(5n)) { --ink: var(--q4); }
  :global([data-band]) .list > :global(.item:nth-child(4n + 1)) { --ink: var(--c0); }
  :global([data-band]) .list > :global(.item:nth-child(4n + 2)) { --ink: var(--c1); }
  :global([data-band]) .list > :global(.item:nth-child(4n + 3)) { --ink: var(--c2); }
  :global([data-band]) .list > :global(.item:nth-child(4n)) { --ink: var(--c3); }

  [data-layout='row'] {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2rem 2.2rem;
    max-width: none;
  }

  [data-layout='grid'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 1.6rem;
    max-width: none;
  }

  [data-layout='ruled'] {
    gap: 0;
  }

  [data-layout='steps'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.2rem;
    max-width: none;
  }

  /* two columns need room: one where the section's column is narrow
     (Block.astro's container), or, in a post's prose, which has none,
     where the screen is */
  @container (width < 34rem) {
    [data-layout='grid'],
    [data-layout='steps'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    [data-layout='grid'],
    [data-layout='steps'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
