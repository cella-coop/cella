---
// A list (index.md, the lists): its items, each an `Item`, taking the
// five inks in turn however many there are, or on a band the four it
// hands down, leaving out its own, and counted where `numbered`. Its
// items are its `items`, or its slot, the `Item`s a page writes inline.
// Its `layout`:
//   `column`, unset: cells down the page, each beside its words;
//   `row`: cells side by side, each over its words, as many as fit;
//   `grid`: cells in two columns, each beside its words;
//   `ruled`: no cells, a title and its words in two columns every row
//     shares, a rule under each;
//   `steps`: no cells, a large numeral in the item's ink over its title
//     and words, in two columns.
import { inline } from '../lib/inline'
import Item from './Item.astro'

export type Layout = 'column' | 'row' | 'grid' | 'ruled' | 'steps'

interface Props {
  items?: { title: string; body: string; icon?: string; photo?: string }[]
  layout?: Layout
  numbered?: boolean
  seed?: number
  drafted?: true
}

const { items, layout = 'column', numbered = false, seed = 1, drafted } = Astro.props
---

<ul class="list" data-layout={layout} data-numbered={numbered ? '' : undefined} role="list" data-drafted={drafted}>
  {
    items
      ? items.map((it, i) => (
          <Item title={it.title} icon={it.icon} photo={it.photo} seed={seed * 13 + i * 7}>
            <Fragment set:html={inline(it.body)} />
          </Item>
        ))
      : <slot />
  }
</ul>

<style>
  /* a readable measure, near the lede's above it */
  .list {
    display: grid;
    gap: 1.6rem;
    max-width: 34rem;
    margin: 2rem 0 2.25rem;
    padding: 0;
    list-style: none;
    counter-reset: item;
  }

  /* each item's ink, its place in the turn of five; on a band, of the
     four the band hands down as --b0 to --b3, its own left out */
  .list > :global(.item:nth-child(5n + 1)) { --ink: var(--p0); }
  .list > :global(.item:nth-child(5n + 2)) { --ink: var(--p1); }
  .list > :global(.item:nth-child(5n + 3)) { --ink: var(--p2); }
  .list > :global(.item:nth-child(5n + 4)) { --ink: var(--p3); }
  .list > :global(.item:nth-child(5n)) { --ink: var(--p4); }
  :global([data-band]) .list > :global(.item:nth-child(4n + 1)) { --ink: var(--b0); }
  :global([data-band]) .list > :global(.item:nth-child(4n + 2)) { --ink: var(--b1); }
  :global([data-band]) .list > :global(.item:nth-child(4n + 3)) { --ink: var(--b2); }
  :global([data-band]) .list > :global(.item:nth-child(4n)) { --ink: var(--b3); }

  [data-layout='row'] {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2rem 2.2rem;
    max-width: none;
  }

  [data-layout='grid'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 1.6rem;
    max-width: none;
  }

  [data-layout='ruled'] {
    gap: 0;
  }

  [data-layout='steps'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.2rem;
    max-width: none;
  }

  /* two columns need room: one where the section's column is narrow
     (Block.astro's container), or, in a post's prose, which has none,
     where the screen is */
  @container (width < 34rem) {
    [data-layout='grid'],
    [data-layout='steps'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    [data-layout='grid'],
    [data-layout='steps'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
