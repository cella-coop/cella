---
// One section of a page (index.md, the layout), by its kind. The hero
// opens the page; a section with a figure sets it beside its text, on the
// side `flip` gives, the figure bleeding off the screen's outer edge; a
// quote is a band of deep sage, a call to action one of coral that runs
// into the footer, each holding no photo but its diagram, drawn light on
// its colour. Its number, `num`, counts the page's plain sections.
import { cell, roundedPath, type Point } from '@cella/brand'
import type { DiagramName } from '@cella/diagrams'
import type { Status } from '../schemas'
import type { Rendered } from '../lib/text'
import Actions from './Actions.astro'
import Diagram from './Diagram.astro'
import Engraving from './Engraving.astro'
import Heading from './Heading.astro'

interface Props {
  section: Rendered
  ink: Status
  seed: number
  flip?: boolean
  num?: number
  credit: { template: string; unsplash: string }
}

const { section: s, ink, seed, flip = false, num, credit } = Astro.props
const d = s.drafted
const { Content } = s
const hero = s.kind === 'hero'
const band = s.kind === 'quote' ? 'quote' : s.kind === 'cta' ? 'cta' : undefined
// A band's outline, as a cell's: a few long edges meeting at wide,
// rounded corners, in the band's own box, so it stretches with it. The
// corners at the screen's sides stand past it, so only the turns inside
// show rounded
const EDGES: Record<string, Point[]> = {
  quote: [[-0.1, 0.155], [0.34, 0], [1.1, 0.08], [1.1, 0.89], [0.71, 1], [-0.1, 0.94]],
  cta: [[-0.1, 0.07], [0.58, 0], [1.1, 0.125], [1.1, 0.92], [0.36, 1], [-0.1, 0.95]],
}
const outline = band && roundedPath(EDGES[band], 0.07, (v) => v.toFixed(4))
const clip = band && `band-${s.id}`
// a band's diagram; the schema refuses a band that names none
const diagram = band ? (s.diagram as DiagramName) : undefined
const paired = Boolean(s.figure || diagram)
// its actions, the call to act first
const actions = [
  ...(s.primary ? [{ link: s.primary, field: 'primary' }] : []),
  ...(s.action ? [{ link: s.action, field: 'action' }] : []),
  ...(s.secondary ? [{ link: s.secondary, field: 'secondary' }] : []),
]
---

<section id={hero ? undefined : s.id} class:list={['section', { hero }]} data-band={band} style={clip ? { 'clip-path': `url(#${clip})` } : undefined}>
  {
    outline && (
      <svg class="edge" width="0" height="0" aria-hidden="true">
        <clipPath id={clip} clipPathUnits="objectBoundingBox"><path d={outline} /></clipPath>
      </svg>
    )
  }
  {
    s.kind === 'quote' ? (
      <div class="wrap pair">
        <blockquote>
          {Content && <div class="said" data-drafted={d('body')}><Content /></div>}
          <cite class="label" data-drafted={d('heading')}>{s.heading}</cite>
        </blockquote>
        {diagram && <div class="plate"><Diagram name={diagram} band /></div>}
      </div>
    ) : (
      <div class:list={['wrap', paired ? 'pair' : 'single', { flip, overhang: hero }]}>
        <div class="copy">
          {num !== undefined && <span class="num" aria-hidden="true">{String(num).padStart(2, '0')}</span>}
          {s.eyebrow && <p class="label" data-drafted={d('eyebrow')}>{s.eyebrow}</p>}
          <Heading text={s.heading} level={hero ? 1 : 2} drafted={d('heading')} />
          {Content && <div class:list={['body', { lede: s.kind !== 'prose' }]} data-drafted={d('body')}><Content /></div>}
          {
            s.kind === 'features' && s.items.length > 0 && (
              <div class="features" data-drafted={d('items')}>
                {s.items.map((it, i) => (
                  <div class="feature">
                    {/* each item's marker a cell of its own, in the inks in turn */}
                    <svg class="cellmark" viewBox="0 0 100 100" aria-hidden="true"><path d={cell(seed * 13 + i * 7)} style={{ fill: `var(--p${i % 5})` }} /></svg>
                    <div><h3>{it.title}</h3><p>{it.body}</p></div>
                  </div>
                ))}
              </div>
            )
          }
          {
            s.kind === 'steps' && s.items.length > 0 && (
              <ol class="steps" role="list" data-drafted={d('items')}>
                {s.items.map((it, i) => (
                  <li class="step"><span class="n" aria-hidden="true">{i + 1}</span><h3>{it.title}</h3><p>{it.body}</p></li>
                ))}
              </ol>
            )
          }
          {
            s.kind === 'list' && s.items.length > 0 && (
              <ul class="rows" role="list" data-drafted={d('items')}>
                {s.items.map((it) => (
                  <li><span>{it.title}</span><span>{it.body}</span></li>
                ))}
              </ul>
            )
          }
          {actions.length > 0 && <div class="row"><Actions links={actions} ink={ink} seed={seed} drafted={d} /></div>}
        </div>
        {diagram && <div class="plate"><Diagram name={diagram} band /></div>}
        {s.figure && <Engraving figure={s.figure} ink={s.figure.ink ?? ink} seed={seed} bleed={flip ? 'l' : 'r'} aspect={hero ? 1.3 : 1.2} credit={credit} drafted={d} />}
      </div>
    )
  }
</section>

<style>
  .section {
    position: relative;
  }

  .hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .pair.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .pair.flip > :global(figure) {
    order: -1;
  }

  .single {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .single .copy {
    max-width: 44rem;
  }

  /* the hero's figure overhangs the section after it */
  .overhang {
    margin-bottom: clamp(-7rem, -8vw, -3rem);
  }

  .copy {
    display: grid;
    gap: 1.5rem;
    align-content: center;
  }

  .num {
    margin-bottom: -0.5rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 8rem);
    font-weight: 200;
    letter-spacing: -0.04em;
    line-height: 0.8;
    opacity: 0.22;
  }

  .body :global(p) {
    margin: 0;
  }

  .body :global(p + p) {
    margin-top: 1em;
  }

  .lede {
    max-width: 33rem;
    color: var(--text-muted);
    font-size: clamp(1.1rem, 1.45vw, 1.28rem);
  }

  .features {
    display: grid;
    gap: 1.6rem;
    margin-top: 0.5rem;
  }

  .feature {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .cellmark {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
  }

  .feature p,
  .step p {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.2rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .step .n {
    color: var(--p0);
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 250;
    line-height: 1;
  }

  .rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule);
    font-weight: 520;
  }

  .rows li span:last-child {
    color: var(--text-muted);
    font-weight: 400;
  }

  .row {
    display: flex;
  }

  /* the breaks: two shaped bands of ink, their edges cut as a cell's */
  [data-band] {
    padding-block: clamp(7rem, 12vw, 10rem) clamp(5rem, 9vw, 8rem);
  }

  /* a band is a strong ink, its words and its diagram light on it */
  [data-band='quote'] {
    --band: var(--band-a);
    --band-ink: var(--band-a-ink);
  }

  [data-band='cta'] {
    --band: var(--band-b);
    --band-ink: var(--band-b-ink);
    padding-bottom: clamp(5rem, 8vw, 7rem);
  }

  [data-band] {
    --text: var(--band-ink);
    --text-muted: color-mix(in oklch, var(--band-ink) 88%, transparent);
    --dg-ground: var(--band);
    background: var(--band);
    color: var(--band-ink);
  }

  .edge {
    position: absolute;
  }

  [data-band] .pair {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    padding-block: 0;
  }

  .plate {
    justify-self: center;
    width: 100%;
    max-width: 30rem;
  }

  /* on the coral, the cells are the band's own light ink and a veil of it */
  [data-band] .row :global(.actions) {
    --fill: var(--band-ink);
    --on-fill: var(--band);
    --wash: color-mix(in oklch, var(--band-ink) 22%, transparent);
    --on-wash: var(--band-ink);
  }

  blockquote {
    display: grid;
    gap: 1.6rem;
    max-width: 54rem;
    margin: 0;
  }

  .said :global(p) {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 3.1rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .said :global(strong) {
    font-weight: 760;
  }

  cite {
    color: inherit;
    font-style: normal;
    opacity: 0.75;
  }

  @media (max-width: 56rem) {
    .pair,
    .pair.flip,
    [data-band] .pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .pair.flip > :global(figure) {
      order: 0;
    }

    .overhang {
      margin-bottom: 0;
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
