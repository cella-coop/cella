---
// A section of a page (index.md, the layout): its eyebrow, its heading, its
// body, a lede unless `prose` sets it as reading text, holding whatever the
// page places in it, and its photo, engraved in the page's next ink beside
// it. Down the page the sections trade sides; one that asks with `ghost`
// carries a ghost numeral. Its anchor is its heading's words, or `id`.
import type { Status } from '../schemas'
import { inkAt, seedOf } from '../lib/place'
import Block from './Block.astro'

interface Props {
  heading: string
  eyebrow?: string
  id?: string
  photo?: string
  caption?: string
  alt?: string
  // the photo's ink, where the page's turn should not choose it
  ink?: Status
  prose?: boolean
  ghost?: boolean
  // set at build (lib/sections.ts)
  page?: string
  place?: string
  turn?: string
  numeral?: string
}

const { heading, eyebrow, id, photo, caption, alt, ink, prose, page = 'blog', place = '0', turn = '1', numeral } = Astro.props
const at = Number(place)
const own = await inkAt(page, Number(turn))
const kind = 'section'
---

<Block
  kind={kind}
  id={id}
  heading={heading}
  eyebrow={eyebrow}
  figure={photo ? { photo, caption, alt, ink } : undefined}
  ink={own}
  prose={prose}
  flip={at % 2 === 0}
  numeral={numeral ? Number(numeral) : undefined}
  seed={seedOf(`${page}/${at}`)}
>
  <slot />
</Block>
