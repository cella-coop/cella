---
// A page's sections, in their order, each with the site's figures handed
// to its body, each a band in the next of the five tones after the hero's.
import { sectionsOf, surfaceOf, toneOf } from '../lib/content'
import { figures } from './figures'
import Section from './Section.astro'

const { page } = Astro.props as { page: string }
const sections = await sectionsOf(page)
---

{
  sections.map(({ id, data, Content }, i) => (
    <Section id={id} {...data} tone={toneOf(i + 1)} surface={surfaceOf(i + 1)}>
      <Content components={figures} />
    </Section>
  ))
}
