---
// The figure a hero or a section names in its frontmatter: a diagram by
// its name, or a photo with its description and print.
import type { PrintStyleName } from '@cella/brand'
import type { DiagramName } from '@cella/diagrams'
import Diagram from './Diagram.astro'
import Photo from './Photo.astro'

type Shown = { diagram: string } | { photo: string; alt: string; print?: string }
const { figure } = Astro.props as { figure: Shown }
---

{
  'diagram' in figure ? (
    <Diagram name={figure.diagram as DiagramName} />
  ) : (
    <Photo name={figure.photo} alt={figure.alt} print={figure.print as PrintStyleName | 'none' | undefined} />
  )
}
