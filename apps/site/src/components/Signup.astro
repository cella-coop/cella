---
// The compact sign-up for news (index.md, the forms): the email field and
// the button as one row of cells, the field plain ink and the button the
// section's, and a box a co-op that might pilot ticks, in line with the
// field's words. It posts to `PUBLIC_SIGNUP_URL`, the list's endpoint.
import type { Status } from '../schemas'
import type { Marks } from '../lib/text'
import Actions from './Actions.astro'
import Check from './Check.astro'

interface Props {
  text: { label: string; placeholder: string; pilot: string; submit: string; done: string; failed: string }
  ink: Status
  drafted: Marks
}

const { text, ink, drafted } = Astro.props
const endpoint = import.meta.env.PUBLIC_SIGNUP_URL ?? ''
const d = (k: string) => drafted(`signup.${k}`)
---

<form class="signup" action={endpoint || undefined} method="post" data-form data-endpoint={endpoint}>
  <Actions ink={ink} seed={11}>
    <input class="cell field" data-tone="plain" type="email" name="email" required autocomplete="email" aria-label={text.label} placeholder={text.placeholder} data-drafted={d('label')} />
    <button class="cell" data-tone="fill" type="submit" data-drafted={d('submit')}>{text.submit}</button>
  </Actions>
  <div class="ticks"><Check name="pilot" label={text.pilot} ink={ink} drafted={d('pilot')} /></div>
  <p class="said" role="status" aria-live="polite" hidden></p>
  <template data-done>{text.done}</template>
  <template data-failed>{text.failed}</template>
</form>

<script>
  import { wire } from '../lib/send'

  wire('.signup[data-form]')
</script>

<style>
  .signup {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    min-width: 0;
  }

  .signup :global(.actions) {
    width: min(100%, 30rem);
  }

  .field {
    flex: 1;
    cursor: text;
    font-weight: 500;
  }

  .field::placeholder {
    color: var(--text);
    opacity: 0.45;
  }

  [data-busy] button {
    opacity: 0.6;
    cursor: progress;
  }

  /* the box stands in from the row's bulge, in line with the field's words */
  .ticks {
    padding-left: 1.7rem;
  }

  .said {
    margin: 0;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 30rem) {
    .ticks {
      padding-left: 1.2rem;
    }
  }
</style>
