---
// The theme toggle: a moon in the light theme and a sun in the dark, both
// Phosphor duotone. A press wears the other theme and remembers it; a
// press back to the system's theme forgets the choice, so the page follows
// the system again.
import { iconMarkup } from '../lib/icon'

const { label } = Astro.props as { label: string }
---

<button class="toggle" type="button" aria-label={label} data-theme-toggle>
  <span class="moon" set:html={iconMarkup('moon', 'accent')} />
  <span class="sun" set:html={iconMarkup('sun', 'accent')} />
</button>

<script>
  const root = document.documentElement
  const dark = matchMedia('(prefers-color-scheme: dark)')
  const store = (t: string | null) => {
    try {
      if (t) {
        localStorage.setItem('theme', t)
      } else {
        localStorage.removeItem('theme')
      }
    } catch {}
  }
  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const system = dark.matches ? 'dark' : 'light'
      const next = (root.dataset.theme ?? system) === 'dark' ? 'light' : 'dark'
      if (next === system) {
        delete root.dataset.theme
        store(null)
      } else {
        root.dataset.theme = next
        store(next)
      }
    })
  }
</script>

<style>
  .toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--panel);
    color: var(--text);
    cursor: pointer;
    transition: background 120ms var(--ease);
  }

  .toggle:hover {
    background: var(--hover);
  }

  .toggle:focus-visible {
    outline: 2px solid var(--accent-ring);
    outline-offset: 2px;
  }

  .toggle span {
    display: inline-flex;
    width: 100%;
    height: 100%;
  }

  .sun {
    display: none !important;
  }

  :global([data-theme='dark']) .sun {
    display: inline-flex !important;
  }

  :global([data-theme='dark']) .moon {
    display: none !important;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: inline-flex !important;
    }

    :global(:root:not([data-theme='light'])) .moon {
      display: none !important;
    }
  }
</style>
