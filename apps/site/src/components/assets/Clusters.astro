---
// The clusters a figure may be cut into, side by side on the same photos
// for the operator to choose from: the blob the pages wear, the organic
// silhouettes and a few icons, each with its cells sized by the cluster's
// middle and by the photo's interest. Every tile is named by its
// silhouette, and `+interest` where its interest sizes it.
import { cluster, ORGANIC, type Silhouette } from '@cella/brand'
import { interestIn } from '../../lib/interest'
import { iconField } from '../../lib/silhouette'
import { STATUSES } from '../../schemas'
import Cut from '../Cut.astro'

const PHOTOS = ['people-raising-their', 'diverse-group-of']
const ICONS = ['users-three', 'house', 'hand-heart', 'tree', 'chat-circle']
const SEED = 11
const [w, h] = [1000, 833]

// an icon's cells are finer, so its outline reads
const shapes: { name: string; silhouette: Silhouette; pitch: number; loose: number }[] = [
  { name: 'blob', silhouette: 'blob', pitch: 115, loose: 1 },
  ...ORGANIC.map((kind) => ({ name: kind, silhouette: kind, pitch: 115, loose: 1 })),
  ...(await Promise.all(ICONS.map(async (icon) => ({ name: `icon:${icon}`, silhouette: { field: await iconField(icon, w, h) }, pitch: 58, loose: 0 })))),
]

const photos = await Promise.all(
  PHOTOS.map(async (photo, p) => {
    const interest = await interestIn(photo, w, h)
    return {
      photo,
      rows: shapes.map((s, i) => ({
        name: s.name,
        ink: STATUSES[(i + p) % STATUSES.length],
        cuts: [undefined, interest].map((field) => ({
          label: field ? `${s.name}+interest` : s.name,
          cells: cluster(w, h, { pitch: s.pitch, gutter: s.pitch / 9.5, round: s.pitch / 7, seed: SEED, drop: 0.25, silhouette: s.silhouette, interest: field, loose: s.loose }),
        })),
      })),
    }
  }),
)
---

{
  photos.map(({ photo, rows }) => (
    <section class="photo">
      <h2>
        <code>{photo}</code>
      </h2>
      <ul class="grid" role="list">
        {rows.flatMap((row) =>
          row.cuts.map((cut, k) => (
            <li class="tile">
              <Cut photo={photo} ink={row.ink} cells={cut.cells} w={w} h={h} id={`cl-${photo}-${row.name.replace(':', '-')}-${k}`} label={cut.label} />
              <p class="name">
                <code>{cut.label}</code>
              </p>
            </li>
          )),
        )}
      </ul>
    </section>
  ))
}

<style>
  .photo + .photo {
    margin-top: 3rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: var(--t-lg);
    font-weight: normal;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .name {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
