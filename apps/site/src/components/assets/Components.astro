---
// The site's components, each by its name.
import Actions from '../Actions.astro'
import ThemeToggle from '../ThemeToggle.astro'
import { siteData } from '../../lib/text'

const site = await siteData()
const links = ['first', 'second', 'third'].map((label) => ({ link: { label, href: '#' }, field: label }))
---

<ul class="grid" role="list">
  <li>
    <div class="card">
      <Actions links={links} ink={'error'} seed={7} drafted={() => undefined} />
    </div>
    <p class="name"><code>{'actions'}</code></p>
  </li>
  <li>
    <div class="card">
      <ThemeToggle label={site.theme.toggle} />
    </div>
    <p class="name"><code>{'theme-toggle'}</code></p>
  </li>
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .name {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
  }
</style>
