---
// Every photo of the library as a page wears it (index.md, the assets):
// the site's own figure (Engraving.astro) in a section's own grid, grey
// bars standing for its words, so scale, place and bleed are a page's.
// Two buttons that follow the page choose what each shows: its side, the
// figure right of its words bleeding off the right as most sections' do,
// or left of them bleeding off the left as a flipped one's; and the
// screen, a wide one, or a phone, 390px wide, where the figure stacks
// under its words in its narrow cut and bleeds right. The ink turns per
// photo; each photo's seed is its name's. The choice is kept in the
// browser.
import { cluster } from '@cella/brand'
import { photoNames } from '../../lib/assets'
import { focusIn } from '../../lib/focus'
import { iconMarkup } from '../../lib/icon'
import { seedOf } from '../../lib/place'
import { siteData } from '../../lib/text'
import { STATUSES } from '../../schemas'
import Cut from '../Cut.astro'
import Engraving from '../Engraving.astro'

const site = await siteData()
const credit = { template: site.photo.credit, unsplash: site.photo.unsplash }
const none = () => undefined

// the phone's cut, as Engraving cuts its narrow one
const W = 1000
const HN = Math.round(W / 1.9)
const photos = await Promise.all(
  photoNames().map(async (photo, i) => {
    const seed = seedOf(photo)
    const narrow = cluster(W, HN, { pitch: 115, gutter: 12, round: 16, seed, drop: 0.25, bleed: 'r', focus: await focusIn(photo, W, HN) })
    return { photo, seed, ink: STATUSES[i % STATUSES.length], narrow }
  }),
)
const SIDES = ['r', 'l'] as const
// the toggles, named by the attribute each turns
const [screen, side] = ['screen', 'side']
const icons = {
  wide: iconMarkup('monitor', 'current'),
  phone: iconMarkup('device-mobile', 'current'),
  r: iconMarkup('align-right', 'current'),
  l: iconMarkup('align-left', 'current'),
}
const bars = [100, 92, 96, 64]
---

<div class="cutouts" data-screen="wide" data-side="r">
  <ul class="photos" role="list">
    {
      photos.map(({ photo, seed, ink, narrow }) => (
        <li class="photo">
          <h2>
            <code>{photo}</code>
          </h2>
          {SIDES.map((s) => (
            <div class="pair" data-on="wide" data-side={s}>
              <div class="words" aria-hidden="true">
                {bars.map((b) => (
                  <span style={{ width: `${b}%` }} />
                ))}
              </div>
              <Engraving figure={{ photo }} ink={ink} seed={seed} bleed={s} aspect={1.2} credit={credit} drafted={none} />
            </div>
          ))}
          <div class="phone" data-on="phone">
            <div class="words" aria-hidden="true">
              {bars.map((b) => (
                <span style={{ width: `${b}%` }} />
              ))}
            </div>
            <div class="bleed">
              <Cut photo={photo} ink={ink} cells={narrow} w={W} h={HN} id={`co-${photo}-phone`} label={photo} />
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="fab" role="toolbar">
    <button type="button" class="toggle" data-toggle="screen" data-values="wide phone" aria-label={screen}>
      <span data-show="wide" set:html={icons.wide} />
      <span data-show="phone" set:html={icons.phone} />
    </button>
    <button type="button" class="toggle" data-toggle="side" data-values="r l" aria-label={side}>
      <span data-show="r" set:html={icons.r} />
      <span data-show="l" set:html={icons.l} />
    </button>
  </div>
</div>

<script>
  // each toggle turns its attribute to its next value, kept in the browser
  const root = document.querySelector<HTMLElement>('.cutouts')!
  for (const button of root.querySelectorAll<HTMLButtonElement>('[data-toggle]')) {
    const key = button.dataset.toggle!
    const values = button.dataset.values!.split(' ')
    try {
      const kept = localStorage.getItem(`cutouts-${key}`)
      if (kept && values.includes(kept)) {
        root.dataset[key] = kept
      }
    } catch {}
    button.addEventListener('click', () => {
      const next = values[(values.indexOf(root.dataset[key]!) + 1) % values.length]
      root.dataset[key] = next
      try {
        localStorage.setItem(`cutouts-${key}`, next)
      } catch {}
    })
  }
</script>

<style>
  .photos {
    display: grid;
    gap: 4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: var(--t-lg);
    font-weight: normal;
  }

  /* a section's own grid (Block.astro's .pair): words five twelfths,
     the figure seven, the figure first where the section is flipped */
  .pair {
    display: none;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .pair[data-side='l'] {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .pair[data-side='l'] > :global(figure) {
    order: -1;
  }

  .cutouts[data-screen='wide'][data-side='r'] .pair[data-side='r'],
  .cutouts[data-screen='wide'][data-side='l'] .pair[data-side='l'] {
    display: grid;
  }

  /* words, as grey bars of a lede's measure */
  .words {
    display: grid;
    gap: 0.9rem;
  }

  .words span {
    display: block;
    height: 0.8rem;
    border-radius: 0.4rem;
    background: color-mix(in oklch, var(--text) 12%, transparent);
  }

  .words span:first-child {
    height: 2.2rem;
    margin-bottom: 0.6rem;
    background: color-mix(in oklch, var(--text) 18%, transparent);
  }

  /* a phone, 390px wide, its words over its figure, the figure bleeding
     off its right edge past a 16px gutter */
  .phone {
    display: none;
    width: 390px;
    margin-inline: auto;
    padding: 2rem 16px;
    border: 1px solid color-mix(in oklch, var(--text) 20%, transparent);
    border-radius: 2rem;
    overflow: hidden;
  }

  .cutouts[data-screen='phone'] .phone {
    display: grid;
    gap: 2rem;
  }

  .phone .bleed {
    margin-right: -16px;
  }

  .phone .bleed :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* the buttons, following the page in its corner */
  .fab {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 20;
    display: flex;
    gap: 0.6rem;
  }

  .toggle {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0.8rem;
    border: 0;
    border-radius: 1.1rem 0.6rem 1.2rem 0.7rem;
    background: var(--text);
    color: var(--panel);
    box-shadow: 0 0.4rem 1.2rem color-mix(in oklch, var(--text) 25%, transparent);
    cursor: pointer;
  }

  .toggle span {
    display: none;
    width: 100%;
    height: 100%;
  }

  .toggle :global(svg) {
    width: 100%;
    height: 100%;
  }

  .cutouts[data-screen='wide'] [data-toggle='screen'] [data-show='wide'],
  .cutouts[data-screen='phone'] [data-toggle='screen'] [data-show='phone'],
  .cutouts[data-side='r'] [data-toggle='side'] [data-show='r'],
  .cutouts[data-side='l'] [data-toggle='side'] [data-show='l'] {
    display: block;
  }

  .cutouts[data-screen='phone'] [data-toggle='side'] {
    opacity: 0.4;
  }
</style>
