---
// Every icon the site draws, in every role: the theme toggle's and the
// menu's, and the library's own.
import Icon from '../Icon.astro'
import { PARTS } from '../../lib/assets'
import { STATUSES } from '../../lib/photo'

const icons = [...new Set(['sun', 'moon', 'list', ...PARTS.map((p) => p.icon)])].sort()
const roles = ['accent', ...STATUSES] as const
---

<table>
  <thead>
    <tr>
      <th />
      {
        roles.map((r) => (
          <th>
            <code>{r}</code>
          </th>
        ))
      }
    </tr>
  </thead>
  <tbody>
    {
      icons.map((name) => (
        <tr>
          <th>
            <code>{name}</code>
          </th>
          {roles.map((r) => (
            <td>
              <Icon name={name} role={r} />
            </td>
          ))}
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  table {
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.5rem 0.9rem;
    font-weight: normal;
    text-align: center;
  }

  tbody tr + tr {
    border-top: 1px solid var(--line);
  }

  tbody th {
    color: var(--text-muted);
    text-align: start;
  }

  td :global(.icon) {
    width: 2rem;
  }
</style>
