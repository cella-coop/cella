---
// Every photo of the library as the site prints it, on the print's paper
// in a real ink, each in an ink drawn at random on every load. Hovering one
// shows a toolbar of the five inks; a press wears that ink. A print's dots
// are the same in any ink, so a change of ink is a change of colour alone.
// A press on a photo opens it large, printed at the enlarged width, in its
// ink; a press anywhere, or escape, closes it.
import Backdrop from '../Backdrop.astro'
import { photoNames } from '../../lib/assets'
import { STATUSES } from '../../lib/photo'
import { maskUrl, ratio } from '../../lib/print'

const photos = await Promise.all(
  photoNames().map(async (name) => ({
    name,
    ink: STATUSES[Math.floor(Math.random() * STATUSES.length)],
    full: maskUrl(name, 'full'),
    ratio: await ratio(name),
  })),
)
---

<ul class="grid" role="list">
  {
    photos.map(({ name, ink, full, ratio }) => (
      <li class="tile" data-ink={ink} data-name={name} data-full={full} data-ratio={ratio}>
        <div class="print">
          <Backdrop photo={{ photo: name, ink }} size={'small'} />
          <div class="tools" role="toolbar" aria-label={name}>
            {STATUSES.map((s) => (
              <button type="button" class="ink" data-set={s} aria-label={s} aria-pressed={s === ink ? 'true' : 'false'} style={{ '--swatch': `var(--print-${s}-deep)` }} />
            ))}
          </div>
        </div>
        <p class="name">
          <code>{name}</code>
        </p>
      </li>
    ))
  }
</ul>

<dialog class="lightbox">
  <div class="large"><span /></div>
  <p class="name"><code /></p>
</dialog>

<script>
  const box = document.querySelector<HTMLDialogElement>('.lightbox')!
  const large = box.querySelector<HTMLElement>('.large')!
  for (const print of document.querySelectorAll<HTMLElement>('.tile .print')) {
    print.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.tools, .credit')) {
        return
      }
      const tile = print.closest<HTMLElement>('.tile')!
      large.style.setProperty('--mask', `url(${tile.dataset.full})`)
      large.style.setProperty('--ink', `var(--print-${tile.dataset.ink}-deep)`)
      large.style.setProperty('--ratio', tile.dataset.ratio!)
      box.querySelector('code')!.textContent = tile.dataset.name!
      box.showModal()
    })
  }
  box.addEventListener('click', () => box.close())
  for (const button of document.querySelectorAll<HTMLButtonElement>('.tile .ink')) {
    button.addEventListener('click', () => {
      const tile = button.closest<HTMLElement>('.tile')!
      const ink = button.dataset.set!
      tile.querySelector<HTMLElement>('.backdrop')!.style.setProperty('--ink', `var(--print-${ink}-deep)`)
      tile.dataset.ink = ink
      for (const b of tile.querySelectorAll('.ink')) {
        b.setAttribute('aria-pressed', String(b === button))
      }
    })
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .print {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: zoom-in;
  }

  /* The enlarged print: the photo's whole frame, as large as the window lets */
  .lightbox {
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: none;
    outline: none;
    cursor: zoom-out;
  }

  .lightbox::backdrop {
    background: oklch(0.15 0 0 / 80%);
  }

  .large {
    position: relative;
    width: min(92vw, 1200px, calc(84vh * var(--ratio)));
    aspect-ratio: var(--ratio);
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius);
    background: var(--print-paper);
  }

  .large span {
    position: absolute;
    inset: 0;
    background: var(--ink);
    mask: var(--mask) center / cover no-repeat;
    mix-blend-mode: multiply;
  }

  .lightbox .name {
    color: oklch(0.85 0 0);
    text-align: center;
  }

  .print :global(.credit) {
    opacity: 0;
    transition: opacity 120ms var(--ease);
  }

  .tools {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    display: flex;
    gap: 0.35rem;
    padding: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklch, var(--panel) 90%, transparent);
    box-shadow: var(--shadow-float);
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      opacity 120ms var(--ease),
      transform 120ms var(--ease);
  }

  .print:hover .tools,
  .print:focus-within .tools,
  .print:hover :global(.credit),
  .print:focus-within :global(.credit) {
    opacity: 1;
    transform: none;
  }

  .ink {
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 50%;
    background: var(--swatch);
    cursor: pointer;
  }

  .ink[aria-pressed='true'] {
    border-color: var(--text);
  }

  .ink:focus-visible {
    outline: 2px solid var(--accent-ring);
    outline-offset: 2px;
  }

  .name {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
  }
</style>
