---
// Every photo of the library as the site prints it, a backdrop in one
// tone, each in an ink drawn at random on every load. Hovering one shows a
// toolbar of the five inks; a press wears that ink. A print's dots are the
// same in any ink, so a change of ink is a change of colour alone.
import Backdrop from '../Backdrop.astro'
import { photoNames } from '../../lib/assets'
import { STATUSES } from '../../lib/photo'

const photos = photoNames().map((name) => ({
  name,
  ink: STATUSES[Math.floor(Math.random() * STATUSES.length)],
}))
---

<ul class="grid" role="list">
  {
    photos.map(({ name, ink }) => (
      <li class="tile" data-ink={ink}>
        <div class="print">
          <Backdrop photo={{ photo: name, ink }} width={800} />
          <div class="tools" role="toolbar" aria-label={name}>
            {STATUSES.map((s) => (
              <button type="button" class="ink" data-set={s} aria-label={s} aria-pressed={s === ink ? 'true' : 'false'} style={{ '--swatch': `var(--tone-${s})` }} />
            ))}
          </div>
        </div>
        <p class="name">
          <code>{name}</code>
        </p>
      </li>
    ))
  }
</ul>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.tile .ink')) {
    button.addEventListener('click', () => {
      const tile = button.closest<HTMLElement>('.tile')!
      const ink = button.dataset.set!
      tile.querySelector<HTMLElement>('.backdrop')!.style.setProperty('--tone', `var(--tone-${ink})`)
      tile.dataset.ink = ink
      for (const b of tile.querySelectorAll('.ink')) {
        b.setAttribute('aria-pressed', String(b === button))
      }
    })
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .print {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .print :global(.credit) {
    opacity: 0;
    transition: opacity 120ms var(--ease);
  }

  .tools {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    display: flex;
    gap: 0.35rem;
    padding: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklch, var(--panel) 90%, transparent);
    box-shadow: var(--shadow-float);
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      opacity 120ms var(--ease),
      transform 120ms var(--ease);
  }

  .print:hover .tools,
  .print:focus-within .tools,
  .print:hover :global(.credit),
  .print:focus-within :global(.credit) {
    opacity: 1;
    transform: none;
  }

  .ink {
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 50%;
    background: oklch(0.6 var(--swatch));
    cursor: pointer;
  }

  .ink[aria-pressed='true'] {
    border-color: var(--text);
  }

  .ink:focus-visible {
    outline: 2px solid var(--accent-ring);
    outline-offset: 2px;
  }

  .name {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
  }
</style>
