---
// A page of the site, or a post: the header with the page marked in its
// links, the page's body, its hero and sections as it places them, and
// the footer. Words its body writes outside a section keep to a readable
// column at the sections' left edge, as a post's prose does. A page drafted
// whole is marked so; an unlisted one is kept from search engines, and a
// header that links one fails the build; a draft one's links leave the
// header and the footer where a build leaves it out.
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { refuse } from '../lib/refuse'
import { held, linkedPage, siteData, unlisted } from '../lib/text'
import Base from './Base.astro'

interface Props {
  title: string
  description?: string
  unlisted?: boolean
  drafted?: boolean
  // its card, where it is shared (lib/meta.ts)
  card?: string
}

const { title, description, unlisted: hidden = false, drafted = false, card } = Astro.props
const site = await siteData()
const full = title === site.title ? title : site.titled.replace('{page}', title).replace('{site}', site.title)

const kept = await unlisted()
const linked = site.nav.filter((l) => kept.includes(l.href.replace(/^\/|\/$/g, '')))
if (linked.length > 0) {
  throw refuse.unlistedInNav(linked.map((l) => l.href))
}
// a draft page's links leave the header and the footer where a build
// leaves the page out
const out = await held()
const nav = site.nav.filter((l) => !out.includes(linkedPage(l.href)))
---

<Base title={full} description={description ?? site.description} noindex={hidden} card={card} name={site.title}>
  <Header title={site.title} nav={nav} toggle={site.theme.toggle} menu={site.menu} cta={site.cta} drafted={site.drafted} />
  <main class="flow" data-drafted={drafted || undefined}>
    <slot />
  </main>
  <Footer footer={site.footer} nav={nav} email={site.email} drafted={site.drafted} />
</Base>

<style>
  /* what a page writes outside its sections: a readable column at the
     sections' left edge */
  .flow > :global(:not(section, script, style)) {
    box-sizing: border-box;
    max-width: calc(44rem + 32px);
    margin-inline: max(0px, calc((100% - var(--wrap)) / 2)) auto;
    padding-inline: max(16px, env(safe-area-inset-left, 0px));
  }
</style>
