---
// Every page folder but home and the blog's, at `/<name>`: its hero, then
// its sections.
import Page from '../layouts/Page.astro'
import { page, pageNames } from '../lib/text'

export async function getStaticPaths() {
  return (await pageNames()).filter((p) => p !== 'home' && p !== 'blog').map((p) => ({ params: { page: p } }))
}

const name = Astro.params.page
const { hero, sections } = await page(name)
---

<Page name={name} hero={hero} sections={sections} />
