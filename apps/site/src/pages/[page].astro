---
// Every page but home and the blog's, at `/<name>`: whatever its file's
// body places.
import { figures } from '../components/figures'
import Page from '../layouts/Page.astro'
import { page, pageNames } from '../lib/text'

export async function getStaticPaths() {
  return (await pageNames()).filter((p) => p !== 'home' && p !== 'blog').map((p) => ({ params: { page: p } }))
}

const { Content, ...p } = await page(Astro.params.page)
---

<Page {...p}>
  <Content components={figures} />
</Page>
