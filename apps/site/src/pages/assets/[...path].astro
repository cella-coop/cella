---
// The asset library, at `/assets` in the dev server alone: no build has it
// and no page of the site links to it (index.md, the assets). Its index
// leads to its parts, each a page of its own; its only words are names.
import Icon from '../../components/Icon.astro'
import Clusters from '../../components/assets/Clusters.astro'
import Components from '../../components/assets/Components.astro'
import Diagrams from '../../components/assets/Diagrams.astro'
import Icons from '../../components/assets/Icons.astro'
import Interest from '../../components/assets/Interest.astro'
import Photos from '../../components/assets/Photos.astro'
import Assets from '../../layouts/Assets.astro'
import { PARTS, type Part } from '../../lib/assets'

export function getStaticPaths() {
  if (!import.meta.env.DEV) {
    return []
  }
  return [{ params: { path: undefined } }, ...PARTS.map((p) => ({ params: { path: p.name } }))]
}

const part = Astro.params.path as Part | undefined
---

<Assets part={part}>
  {
    !part && (
      <ul class="parts" role="list">
        {PARTS.map((p) => (
          <li>
            <a href={`/assets/${p.name}`}>
              <Icon name={p.icon} />
              <code>{p.name}</code>
            </a>
          </li>
        ))}
      </ul>
    )
  }
  {part === 'photos' && <Photos />}
  {part === 'clusters' && <Clusters />}
  {part === 'interest' && <Interest />}
  {part === 'diagrams' && <Diagrams />}
  {part === 'icons' && <Icons />}
  {part === 'components' && <Components />}
</Assets>

<style>
  .parts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .parts a {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    font-size: var(--t-lg);
    text-decoration: none;
    transition: background 120ms var(--ease);
  }

  .parts a:hover {
    background: var(--hover);
  }

  .parts code {
    font-family: var(--font-mono);
  }
</style>
