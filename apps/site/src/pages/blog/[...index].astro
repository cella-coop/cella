---
// The blog's index: what the blog page's file places, its hero first,
// then every post newest first, one to a row, each an avatar where it
// names a cover: its photo engraved small and cut into a few of the
// brand's cells round its focus, and beside them, in the same diagram, a
// panel holding its date, title and summary, the panel on the right and
// the left in turn, under the photo on a narrow screen. A post with no
// cover is its words alone. A whole card is its link. A cover wears the
// post's own ink, the same here and on the post (postInk). It is a rest
// route of one path, `/blog/`, so a build leaves it out while the blog's
// page is a draft.
import Avatar from '../../components/Avatar.astro'
import { figures } from '../../components/figures'
import Page from '../../layouts/Page.astro'
import { coverUrl } from '../../lib/engrave'
import { postInk, seedOf } from '../../lib/place'
import { dated, held, page, posts, siteData } from '../../lib/text'

export async function getStaticPaths() {
  return (await held()).includes('blog') ? [] : [{ params: { index: undefined } }]
}

const { Content, ...p } = await page('blog')
const site = await siteData()
const all = await posts()
const inks = await Promise.all(all.map((post) => postInk(post.id)))
const sides = ['right', 'left'] as const
---

<Page {...p}>
  <Content components={figures} />
  <section class="wrap list">
    {
      all.length === 0 ? (
        <p class="empty" data-drafted={site.drafted('blog.empty')}>{site.blog.empty}</p>
      ) : (
        <ol class="cards" role="list">
          {all.map((post, i) => (
            <li>
              <a class="card" href={`/blog/${post.id}/`}>
                {post.data.photo ? (
                  <Avatar photo={post.data.photo} ink={inks[i]} seed={seedOf(`blog/${post.id}`)} side={sides[i % 2]} src={coverUrl(post.data.photo)} id={`cover-${post.id}`} label={post.data.alt ?? post.data.caption ?? post.data.title}>
                    <time class="label" datetime={post.data.date.toISOString()}>{dated(post.data.date)}</time>
                    <h2>{post.data.title}</h2>
                    <p>{post.data.description}</p>
                  </Avatar>
                ) : (
                  <div class="bare">
                    <time class="label" datetime={post.data.date.toISOString()}>{dated(post.data.date)}</time>
                    <h2>{post.data.title}</h2>
                    <p>{post.data.description}</p>
                  </div>
                )}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Page>

<style>
  .list {
    padding-block: 4rem 6rem;
  }

  .cards {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    max-width: 60rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: block;
    text-decoration: none;
    transition: transform 160ms var(--ease);
  }

  .card:hover {
    transform: translateY(-0.2rem);
  }

  .card:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
  }

  .bare {
    display: grid;
    gap: 0.55rem;
  }

  /* the words read as the cover's caption, a short measure */
  h2 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(1.45rem, 2.2vw, 1.9rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  p {
    max-width: 38ch;
    margin: 0;
    color: var(--text-muted);
    text-wrap: pretty;
  }
</style>
