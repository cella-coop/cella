---
// One post at `/blog/<name>/`: its title as the hero, its date above and
// its summary under as the lede, its cover beside it where it names one,
// its authors, its body, prose in a
// readable column and the sections it places as a page's, and the way
// back to the index.
import { render } from 'astro:content'
import { figures } from '../../components/figures'
import Hero from '../../components/Hero.astro'
import Page from '../../layouts/Page.astro'
import { postInk } from '../../lib/place'
import { dated, posts, siteData } from '../../lib/text'

export async function getStaticPaths() {
  return (await posts()).map((p) => ({ params: { post: p.id }, props: { post: p } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const site = await siteData()
// its cover's ink, the post's own and the same as on the index
const ink = await postInk(post.id)
const blog = 'blog'
---

<Page title={post.data.title} description={post.data.description}>
  <Hero heading={post.data.title} eyebrow={dated(post.data.date)} page={blog} photo={post.data.photo} caption={post.data.caption} alt={post.data.alt} ink={ink}>
    <p>{post.data.description}</p>
  </Hero>
  {
    post.data.authors.length > 0 && (
      <ul class="authors label" role="list">
        {post.data.authors.map((a) => (
          <li>{a}</li>
        ))}
      </ul>
    )
  }
  <Content components={figures} />
  <p class="back"><a href="/blog/" data-drafted={site.drafted('blog.back')}>{site.blog.back}</a></p>
</Page>

<style>
  .authors {
    display: flex;
    flex-wrap: wrap;
    margin-block: 2rem 2.5rem;
    padding: 0;
    list-style: none;
  }

  .authors li + li::before {
    content: ', ';
  }

  .back {
    margin-block: 4rem 6rem;
    color: var(--text-muted);
  }
</style>
