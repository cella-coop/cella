---
// The blog's index: the blog page's hero, then every post newest first,
// its date, title and summary.
import Page from '../../layouts/Page.astro'
import { dated, page, posts, siteData } from '../../lib/text'

const { hero, sections } = await page('blog')
const site = await siteData()
const all = await posts()
---

<Page name="blog" hero={hero} sections={sections}>
  <section class="wrap list">
    {
      all.length === 0 ? (
        <p class="empty" data-drafted={site.drafted('blog.empty')}>{site.blog.empty}</p>
      ) : (
        <ol role="list">
          {all.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>
                <time class="label" datetime={p.data.date.toISOString()}>{dated(p.data.date)}</time>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Page>

<style>
  .list {
    padding-block: 4rem 6rem;
  }

  .list > * {
    max-width: 48rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--rule);
  }

  a {
    display: grid;
    gap: 0.6rem;
    padding-block: 2rem;
    text-decoration: none;
  }

  a:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
  }

  p {
    color: var(--text-muted);
  }
</style>
