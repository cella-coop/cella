---
// The blog's index: what the blog page's file places, its hero first,
// then every post newest first as a card with no frame: its cover where it
// names one, the photo engraved small and cut into the brand's cells round
// its focus, and tight under it, at its left edge, its date, title and
// summary, so cover and words read as one. The cards stand two to a row,
// one on a narrow screen; a whole card is its link. A cover wears the
// post's own ink, the same here and on the post (postInk).
import { cluster } from '@cella/brand'
import Cut from '../../components/Cut.astro'
import { figures } from '../../components/figures'
import Page from '../../layouts/Page.astro'
import { coverUrl } from '../../lib/engrave'
import { focusIn } from '../../lib/focus'
import { postInk, seedOf } from '../../lib/place'
import { dated, page, posts, siteData } from '../../lib/text'

const { Content, ...p } = await page('blog')
const site = await siteData()
const all = await posts()

// a cover's cut: three wide to two tall, its cells a little larger than a
// figure's, cut from the small engraving so its lines hold at a card's
// size, its box trimmed to the cells all round
const [W, H] = [1000, 667]
const bounds = (paths: string[]) => {
  const nums = paths.flatMap((d) => (d.match(/-?\d+(?:\.\d+)?/g) ?? []).map(Number))
  const xs = nums.filter((_, k) => k % 2 === 0)
  const ys = nums.filter((_, k) => k % 2 === 1)
  const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)]
  return { left: Math.floor(x0), wide: Math.ceil(x1 - x0), top: Math.floor(y0), tall: Math.ceil(y1 - y0) }
}
const covers = await Promise.all(
  all.map(async (post) => {
    const photo = post.data.photo
    if (!photo) {
      return undefined
    }
    const seed = seedOf(`blog/${post.id}`)
    const cells = cluster(W, H, { pitch: 135, gutter: 13, round: 18, seed, drop: 0.08, focus: await focusIn(photo, W, H) })
    return { photo, cells, box: bounds(cells), ink: await postInk(post.id), alt: post.data.alt ?? post.data.caption ?? post.data.title }
  }),
)
---

<Page {...p}>
  <Content components={figures} />
  <section class="wrap list">
    {
      all.length === 0 ? (
        <p class="empty" data-drafted={site.drafted('blog.empty')}>{site.blog.empty}</p>
      ) : (
        <ol class="cards" role="list">
          {all.map((p, i) => (
            <li>
              <a class="card" href={`/blog/${p.id}/`}>
                {covers[i] && (
                  <div class="cover">
                    <Cut photo={covers[i].photo} ink={covers[i].ink} cells={covers[i].cells} w={W} h={H} {...covers[i].box} src={coverUrl(covers[i].photo)} id={`cover-${p.id}`} label={covers[i].alt} />
                  </div>
                )}
                <time class="label" datetime={p.data.date.toISOString()}>{dated(p.data.date)}</time>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Page>

<style>
  .list {
    padding-block: 4rem 6rem;
  }

  /* the cards, two to a row, each a cover over its words */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4rem clamp(2rem, 5vw, 4.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    text-decoration: none;
  }

  /* every cover the same proportion, its cut set in it whole, so a row's
     words start level */
  .cover {
    aspect-ratio: 3 / 2;
    margin-bottom: 0.9rem;
  }

  .cover :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
  }

  .card:hover .cover {
    transform: translateY(-0.2rem);
  }

  .cover {
    transition: transform 160ms var(--ease);
  }

  /* the words read as the cover's caption, a short measure under it, not
     a line its full width */
  h2 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(1.45rem, 2.2vw, 1.9rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  p {
    max-width: 38ch;
    margin: 0;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  @media (max-width: 44rem) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }
  }
</style>
