---
// The blog's index: what the blog page's file places, its hero first,
// then every post newest first, its date, title and summary, and beside
// them its cover where it names one: the photo engraved in one large cell,
// as a person's portrait is, set over what the photo is about, so the
// subject stays whole at the size of a hint, in the post's own ink, the
// same here and on the post (postInk).
import { cell } from '@cella/brand'
import Cut from '../../components/Cut.astro'
import { figures } from '../../components/figures'
import Page from '../../layouts/Page.astro'
import { coverUrl } from '../../lib/engrave'
import { focusIn } from '../../lib/focus'
import { postInk, seedOf } from '../../lib/place'
import { dated, page, posts, siteData } from '../../lib/text'

const { Content, ...p } = await page('blog')
const site = await siteData()
const all = await posts()

// a cover's cell: the brand's, in its 100 units, as tall as the photo and
// centred across it on the photo's leading region, kept inside the box,
// the box then trimmed to the cell
const [W, H] = [1000, 720]
const placed = (shape: string, cx: number, cy: number, size: number) => {
  const x0 = Math.min(Math.max(cx - size / 2, 0), W - size)
  const y0 = Math.min(Math.max(cy - size / 2, 0), H - size)
  let k = 0
  const d = shape.replace(/-?\d+(?:\.\d+)?/g, (n) => (((k++ % 2 ? y0 : x0) + (Number(n) * size) / 100)).toFixed(1))
  return { d, box: { left: Math.floor(x0 + size * 0.1), wide: Math.ceil(size * 0.8), top: Math.floor(y0 + size * 0.1), tall: Math.ceil(size * 0.8) } }
}
const covers = await Promise.all(
  all.map(async (post) => {
    const photo = post.data.photo
    if (!photo) {
      return undefined
    }
    const seed = seedOf(`blog/${post.id}`)
    const lead = (await focusIn(photo, W, H)).sort((a, b) => b.r - a.r)[0] ?? { x: W / 2, y: H / 2, r: H / 4 }
    // the photo's whole height, so its subject keeps its setting
    const size = H
    const { d, box } = placed(cell(seed), lead.x, lead.y, size)
    return { photo, cells: [d], box, ink: await postInk(post.id), alt: post.data.alt ?? post.data.caption ?? post.data.title }
  }),
)
---

<Page {...p}>
  <Content components={figures} />
  <section class="wrap list">
    {
      all.length === 0 ? (
        <p class="empty" data-drafted={site.drafted('blog.empty')}>{site.blog.empty}</p>
      ) : (
        <ol role="list">
          {all.map((p, i) => (
            <li>
              <a href={`/blog/${p.id}/`} data-covered={covers[i] ? '' : undefined}>
                <div class="words">
                  <time class="label" datetime={p.data.date.toISOString()}>{dated(p.data.date)}</time>
                  <h2>{p.data.title}</h2>
                  <p>{p.data.description}</p>
                </div>
                {covers[i] && (
                  <div class="cover">
                    <Cut photo={covers[i].photo} ink={covers[i].ink} cells={covers[i].cells} w={W} h={H} {...covers[i].box} src={coverUrl(covers[i].photo)} id={`cover-${p.id}`} label={covers[i].alt} />
                  </div>
                )}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Page>

<style>
  .list {
    padding-block: 4rem 6rem;
  }

  .list > * {
    max-width: 60rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--rule);
  }

  /* a post's words, and its cover beside them where it has one */
  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
    align-items: center;
    padding-block: 2rem;
    text-decoration: none;
  }

  a[data-covered] {
    grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
  }

  .words {
    display: grid;
    gap: 0.6rem;
    max-width: 44rem;
  }

  .cover :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* on a narrow screen the cover stands over the words, smaller */
  @media (max-width: 40rem) {
    a[data-covered] {
      grid-template-columns: minmax(0, 1fr);
    }

    .cover {
      order: -1;
      width: min(100%, 18rem);
    }
  }

  a:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
  }

  p {
    color: var(--text-muted);
  }
</style>
