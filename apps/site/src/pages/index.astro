---
// The home page: its hero at full size, then its sections. Every word it
// shows is the content collections' (index.md, the text).
import Sections from '../components/Sections.astro'
import Page from '../layouts/Page.astro'
import { pageData } from '../lib/content'

const page = await pageData('home')
---

<Page {...page} size={'large'}>
  <Sections page={'home'} />
</Page>
