---
// The landing page: the hero, then the sections in their order. Every
// word it shows is the content collections' (index.md, the text); it
// holds the structure alone.
import { getCollection, getEntry, render } from 'astro:content'
import lockup from '@cella/brand/lockup-stack.svg?raw'
import { figures } from '../components/figures'
import Base from '../layouts/Base.astro'

const site = (await getEntry('site', 'site'))!.data
const sections = await Promise.all(
  (await getCollection('sections'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (s) => ({ id: s.id, heading: s.data.heading, ...(await render(s)) })),
)
---

<Base title={site.title} description={site.description}>
  <header class="hero">
    <h1 class="lockup" set:html={lockup} />
    <p class="line">{site.line}</p>
  </header>
  <main>
    {
      sections.map(({ id, heading, Content }) => (
        <section id={id} aria-labelledby={`${id}-heading`}>
          <h2 id={`${id}-heading`}>{heading}</h2>
          <div class="body">
            <Content components={figures} />
          </div>
        </section>
      ))
    }
  </main>
</Base>

<style>
  .hero {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    padding: clamp(4rem, 14vh, 9rem) 1.5rem clamp(3rem, 10vh, 6rem);
    text-align: center;
  }

  .lockup {
    margin: 0;
    color: var(--text);
  }

  .lockup :global(svg) {
    display: block;
    width: clamp(11rem, 40vw, 18rem);
    height: auto;
  }

  .line {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xl);
  }

  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }

  section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: var(--t-2xl);
  }

  .body > :global(:first-child) {
    margin-top: 0;
  }

  .body > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
