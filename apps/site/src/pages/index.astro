---
// The home page, `pages/home.mdx`: whatever its body places. Every word it
// shows is the text's (index.md, the text).
import { figures } from '../components/figures'
import Page from '../layouts/Page.astro'
import { page } from '../lib/text'

const { Content, ...p } = await page('home')
---

<Page {...p}>
  <Content components={figures} />
</Page>
