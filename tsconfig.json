{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["apps/**/ts/src/**/*.ts", "apps/**/ts/_tests/**/*.ts", "apps/**/ts/_e2e/**/*.ts"],
  "exclude": [
    "**/node_modules/**",
    "apps/org/ts/src/**",
    "apps/org/core/ui/ts/src/**",
    "apps/**/ts/src/app/**",
    "apps/**/ts/src/hooks/**"
  ]
}
